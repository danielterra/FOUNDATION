{
  "name": "FOUNDATION",
  "version": "0.7.0",
  "description": "Simple as a spreadsheet. Powerful as enterprise software",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "tauri": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "update:models": "cd scripts/update-models && cargo run --release",
    "release:major": "cd scripts/release && cargo run --release major",
    "release:minor": "cd scripts/release && cargo run --release minor",
    "release:patch": "cd scripts/release && cargo run --release patch",
    "build:local": "cd scripts/release-local && cargo run --release",
    "build:release": "npm run build && npm run tauri:build",
    "logs": "./scripts/show-logs.sh \"$@\"",
    "clear:chat": "./scripts/clear-chat-history.sh",
    "coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --html",
    "test:perf": "./scripts/perf-test.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/monaspace-krypton": "^5.2.5",
    "@material-symbols/font-400": "^0.40.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@types/dagre": "^0.7.53",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "marked": "^17.0.3",
    "material-symbols": "^0.40.1"
  },
  "devDependencies": {
    "@rdfjs/parser-n3": "^2.1.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "better-sqlite3": "^11.7.0",
    "streamify-string": "^1.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
