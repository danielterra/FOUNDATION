    foundation:countryName "República Federativa do Brasil"@pt ;
    foundation:continent "South America" ;
    foundation:flagEmoji "🇧🇷" ;
    foundation:officialLanguage "Portuguese" ;
    foundation:currency "Real (BRL)" ;
    foundation:phonePrefix "+55" ;
    foundation:centerLatitude -14.235 ;
    foundation:centerLongitude -51.925 ;
    foundation:timezone "America/Sao_Paulo" ;
    foundation:timezone "America/Manaus" ;
    foundation:timezone "America/Fortaleza" ;
    foundation:timezone "America/Noronha" ;
