@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Country
# =============================================================================
# Country (sovereign nation) with geographic and administrative properties
#
# Version: 0.1.0
# License: MIT
# =============================================================================

foundation:Country a owl:Class ;
    rdfs:subClassOf foundation:GeographicLocation ;
    rdfs:label "Country" ;
    rdfs:comment "A sovereign nation or country" ;
    foundation:icon "flag" ;
    rdfs:seeAlso """
Examples:
- Brazil (BR)
- United States (US)
- Portugal (PT)
- Japan (JP)
""" .

# -----------------------------------------------------------------------------
# Country Properties
# -----------------------------------------------------------------------------

foundation:countryCode a owl:DatatypeProperty ;
    rdfs:label "country code" ;
    rdfs:comment "ISO 3166-1 alpha-2 country code (e.g., BR, US, PT)" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :brazil foundation:countryCode "BR" .
""" .

foundation:countryName a owl:DatatypeProperty ;
    rdfs:label "country name" ;
    rdfs:comment "Official name of the country" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :brazil foundation:countryName "Brasil" .
  :brazil foundation:countryName "Brazil"@en .
""" .

foundation:continent a owl:DatatypeProperty ;
    rdfs:label "continent" ;
    rdfs:comment "Continent where the country is located" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :brazil foundation:continent "South America" .
""" .

foundation:flagEmoji a owl:DatatypeProperty ;
    rdfs:label "flag emoji" ;
    rdfs:comment "Unicode emoji representation of the country flag" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :brazil foundation:flagEmoji "🇧🇷" .
""" .

foundation:capital a owl:ObjectProperty ;
    rdfs:label "capital" ;
    rdfs:comment "Capital city of the country" ;
    rdfs:domain foundation:Country ;
    rdfs:range foundation:City ;
    rdfs:seeAlso """
Example:
  :brazil foundation:capital :brasilia .
""" .

foundation:officialLanguage a owl:DatatypeProperty ;
    rdfs:label "official language" ;
    rdfs:comment "Official language(s) of the country" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :brazil foundation:officialLanguage "Portuguese" .
""" .

foundation:currency a owl:DatatypeProperty ;
    rdfs:label "currency" ;
    rdfs:comment "Official currency of the country" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :brazil foundation:currency "Real (BRL)" .
""" .

foundation:phonePrefix a owl:DatatypeProperty ;
    rdfs:label "phone prefix" ;
    rdfs:comment "International phone dialing prefix" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :brazil foundation:phonePrefix "+55" .
""" .

foundation:centerLatitude a owl:DatatypeProperty ;
    rdfs:label "center latitude" ;
    rdfs:comment "Latitude coordinate of the country's geographic center" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :brazil foundation:centerLatitude -14.235 .
""" .

foundation:centerLongitude a owl:DatatypeProperty ;
    rdfs:label "center longitude" ;
    rdfs:comment "Longitude coordinate of the country's geographic center" ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :brazil foundation:centerLongitude -51.925 .
""" .

foundation:timezone a owl:DatatypeProperty ;
    rdfs:label "timezone" ;
    rdfs:comment "IANA timezone identifier(s) for the country (e.g., America/Sao_Paulo, America/New_York). Countries may have multiple timezones." ;
    rdfs:domain foundation:Country ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :brazil foundation:timezone "America/Sao_Paulo" .
  :brazil foundation:timezone "America/Manaus" .
  :unitedStates foundation:timezone "America/New_York" .
  :unitedStates foundation:timezone "America/Los_Angeles" .
""" .

# =============================================================================
# Country Instances
# =============================================================================

