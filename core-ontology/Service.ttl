@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Service
# =============================================================================
# An intangible offering that provides value through actions, labor, or expertise
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:Service a owl:Class ;
    rdfs:subClassOf foundation:AbstractProduct ,
        [ a owl:Restriction ;
          owl:onProperty foundation:providedBy ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Service" ;
    rdfs:comment "An intangible offering that provides value through actions, labor, expertise, or access rather than transfer of physical goods" ;
    foundation:icon "handyman" ;
    rdfs:seeAlso """
Examples:
- Residential cleaning service
- Computer repair service
- Business consulting service
- Software development service
- AWS S3 (cloud storage service - SaaS)
- Netflix (streaming service)
- Uber (transportation service)
- Food delivery service

Services can be:
- Physical services (cleaning, repair, transportation)
- Professional services (consulting, legal, accounting)
- Digital services (SaaS, streaming, cloud computing)

Cardinality constraints:
- providedBy: at least 1 (required, service must have provider(s))
""" .

# -----------------------------------------------------------------------------
# Service Properties
# -----------------------------------------------------------------------------

foundation:providedBy a owl:ObjectProperty ;
    rdfs:label "provided by" ;
    rdfs:comment "The organization or person that provides this service" ;
    rdfs:domain foundation:Service ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  :CleaningService foundation:providedBy :CleaningCompany .
  :AwsS3 foundation:providedBy :AWS .
  :ConsultingService foundation:providedBy :JohnDoeConsultant .
""" .

foundation:recurringService a owl:DatatypeProperty ;
    rdfs:label "recurring service" ;
    rdfs:comment "Whether the service is provided on a recurring/subscription basis" ;
    rdfs:domain foundation:Service ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """
Example:
  :MonthlyCleaningService foundation:recurringService true .
  :OneTimeRepair foundation:recurringService false .
  :NetflixSubscription foundation:recurringService true .
""" .

foundation:apiBaseUrl a owl:DatatypeProperty ;
    rdfs:label "API base URL" ;
    rdfs:comment "Base URL for the service's API endpoints" ;
    rdfs:domain foundation:Service ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso """
Example:
  :ClaudeAIService foundation:apiBaseUrl "https://api.anthropic.com/v1"^^xsd:anyURI .
  :OpenAIService foundation:apiBaseUrl "https://api.openai.com/v1"^^xsd:anyURI .
""" .

foundation:apiModelsEndpoint a owl:DatatypeProperty ;
    rdfs:label "API models endpoint" ;
    rdfs:comment "API endpoint to list available models for this service" ;
    rdfs:domain foundation:Service ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso """
Example:
  :ClaudeAIService foundation:apiModelsEndpoint "https://api.anthropic.com/v1/models"^^xsd:anyURI .
  :OpenAIService foundation:apiModelsEndpoint "https://api.openai.com/v1/models"^^xsd:anyURI .
""" .

foundation:apiMessagesEndpoint a owl:DatatypeProperty ;
    rdfs:label "API messages endpoint" ;
    rdfs:comment "API endpoint to send messages/prompts to the AI service" ;
    rdfs:domain foundation:Service ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso """
Example:
  :ClaudeAIService foundation:apiMessagesEndpoint "https://api.anthropic.com/v1/messages"^^xsd:anyURI .
  :OpenAIService foundation:apiMessagesEndpoint "https://api.openai.com/v1/chat/completions"^^xsd:anyURI .
""" .

foundation:apiVersion a owl:DatatypeProperty ;
    rdfs:label "API version" ;
    rdfs:comment "Version identifier for the API (used in headers or URL)" ;
    rdfs:domain foundation:Service ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :ClaudeAIService foundation:apiVersion "2023-06-01" .
""" .

foundation:apiDocumentation a owl:DatatypeProperty ;
    rdfs:label "API documentation" ;
    rdfs:comment "URL to the official API documentation" ;
    rdfs:domain foundation:Service ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso """
Example:
  :ClaudeAIService foundation:apiDocumentation "https://docs.anthropic.com/en/docs/about-claude/models"^^xsd:anyURI .
""" .

foundation:website a owl:DatatypeProperty ;
    rdfs:label "website" ;
    rdfs:comment "Official website URL" ;
    rdfs:domain foundation:Organization ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso """
Example:
  :AnthropicOrganization foundation:website "https://www.anthropic.com"^^xsd:anyURI .
""" .
