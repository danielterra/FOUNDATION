@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# ConcreteThing
# =============================================================================
# Things that exist in physical or digital form
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:ConcreteThing a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Concrete Thing" ;
    rdfs:comment "Things that exist in physical or digital form" ;
    foundation:icon "widgets" ;
    rdfs:seeAlso """
Examples:
- A person (Daniel Terra)
- A computer (MacBook Pro)
- A file (FOUNDATION.db)
- A building (your house)
""" .
