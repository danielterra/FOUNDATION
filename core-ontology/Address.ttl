@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Address
# =============================================================================
# Physical address using geographic location references
#
# Version: 0.1.0
# License: MIT
# =============================================================================

foundation:Address a owl:Class ;
    rdfs:subClassOf foundation:Concept ;
    rdfs:label "Address" ;
    rdfs:comment "A physical address with references to geographic locations" ;
    foundation:icon "home" ;
    rdfs:seeAlso """
Examples:
- Residential address
- Business address
- Mailing address
- Delivery address

An address combines a street, number, and geographic hierarchy
to uniquely identify a physical location.
""" .

# -----------------------------------------------------------------------------
# Address Properties - Geographic Components
# -----------------------------------------------------------------------------

# Street-level components
foundation:streetNumber a owl:DatatypeProperty ;
    rdfs:label "street number" ;
    rdfs:comment "Precise street number" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:streetNumber "1000" .
  :myAddress foundation:streetNumber "123-A" .
""" .

foundation:route a owl:DatatypeProperty ;
    rdfs:label "route" ;
    rdfs:comment "Named route or street name" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:route "Avenida Paulista" .
  :myAddress foundation:route "Fifth Avenue" .
""" .

# Locality components
foundation:neighborhood a owl:DatatypeProperty ;
    rdfs:label "neighborhood" ;
    rdfs:comment "Named neighborhood or district" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:neighborhood "Cambuí" .
  :myAddress foundation:neighborhood "SoHo" .
""" .

foundation:sublocality a owl:DatatypeProperty ;
    rdfs:label "sublocality" ;
    rdfs:comment "First-order civil entity below locality" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:sublocality "Brooklyn" .
""" .

foundation:locality a owl:DatatypeProperty ;
    rdfs:label "locality" ;
    rdfs:comment "Incorporated city or town" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:locality "Campinas" .
  :myAddress foundation:locality "New York" .
""" .

foundation:postalTown a owl:DatatypeProperty ;
    rdfs:label "postal town" ;
    rdfs:comment "Postal town (commonly used in UK and Sweden)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:postalTown "London" .
""" .

# Administrative areas (hierarchical levels vary by country)
foundation:administrativeAreaLevel1 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 1" ;
    rdfs:comment "First-order civil entity below country (typically state or province)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:administrativeAreaLevel1 "São Paulo" .
  :myAddress foundation:administrativeAreaLevel1 "California" .
""" .

foundation:administrativeAreaLevel2 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 2" ;
    rdfs:comment "Second-order civil entity below country (typically county)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:administrativeAreaLevel2 "Los Angeles County" .
""" .

foundation:administrativeAreaLevel3 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 3" ;
    rdfs:comment "Third-order civil entity below country" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string .

foundation:administrativeAreaLevel4 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 4" ;
    rdfs:comment "Fourth-order civil entity below country" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string .

foundation:administrativeAreaLevel5 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 5" ;
    rdfs:comment "Fifth-order civil entity below country" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string .

# Country
foundation:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:comment "Country name" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:country "Brazil" .
  :myAddress foundation:country "United States" .
""" .

foundation:countryCode a owl:DatatypeProperty ;
    rdfs:label "country code" ;
    rdfs:comment "ISO 3166-1 alpha-2 country code" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:countryCode "BR" .
  :myAddress foundation:countryCode "US" .
""" .

foundation:complement a owl:DatatypeProperty ;
    rdfs:label "complement" ;
    rdfs:comment "Additional address details (apartment, suite, floor, etc.)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:complement "Apto 42" .
  :myAddress foundation:complement "Sala 1001" .
  :myAddress foundation:complement "3º andar" .
""" .

foundation:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "Postal code or ZIP code" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :myAddress foundation:postalCode "13024-000" .  # CEP Brasil
  :myAddress foundation:postalCode "90210" .      # ZIP USA
""" .

foundation:addressType a owl:DatatypeProperty ;
    rdfs:label "address type" ;
    rdfs:comment "Type of address (residential, commercial, mailing, delivery)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:addressType "residential" .
  :businessAddress foundation:addressType "commercial" .
""" .

# -----------------------------------------------------------------------------
# Geographic Coordinates
# -----------------------------------------------------------------------------

foundation:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    rdfs:comment "Latitude coordinate (decimal degrees, -90 to 90)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:latitude -22.9068 .
""" .

foundation:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    rdfs:comment "Longitude coordinate (decimal degrees, -180 to 180)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:longitude -47.0653 .
""" .

# -----------------------------------------------------------------------------
# Additional Address Properties
# -----------------------------------------------------------------------------

foundation:fullAddress a owl:DatatypeProperty ;
    rdfs:label "full address" ;
    rdfs:comment "Complete address as a single formatted string (for display purposes). This is derived from the location hierarchy and other address properties." ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:fullAddress "Av. Paulista, 1000 - Cambuí, Campinas - SP, 13024-000, Brasil" .

This string is typically computed from:
  - street name (from foundation:location)
  - streetNumber
  - complement
  - neighborhood, city, state, country (via foundation:isPartOf chain)
  - postalCode
""" .

foundation:landmark a owl:DatatypeProperty ;
    rdfs:label "landmark" ;
    rdfs:comment "Reference point or landmark near the address" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:landmark "Próximo ao shopping Iguatemi" .
""" .

foundation:instructions a owl:DatatypeProperty ;
    rdfs:label "instructions" ;
    rdfs:comment "Special delivery or access instructions" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:instructions "Portão azul, tocar interfone apto 42" .
""" .
