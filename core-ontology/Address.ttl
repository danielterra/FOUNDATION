@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Address
# =============================================================================
# Physical address using geographic location references
#
# Version: 0.2.0
# License: MIT
# =============================================================================

<http://foundation.local/ontology/Address>
  a owl:Ontology ;
  rdfs:label "FOUNDATION Address Ontology" ;
  rdfs:comment "Physical address with references to geographic locations" ;
  owl:imports <http://foundation.local/ontology/Street> ,
              <http://foundation.local/ontology/Neighborhood> ,
              <http://foundation.local/ontology/City> ,
              <http://foundation.local/ontology/State> ,
              <http://foundation.local/ontology/Country> ;
.

foundation:Address a owl:Class ;
    rdfs:subClassOf foundation:Concept ,
        [ a owl:Restriction ;
          owl:onProperty foundation:streetNumber ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:route ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:hasStreet ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:neighborhood ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:hasNeighborhood ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:sublocality ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:locality ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:postalTown ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:hasCity ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:administrativeAreaLevel1 ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:hasState ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:administrativeAreaLevel2 ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:administrativeAreaLevel3 ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:administrativeAreaLevel4 ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:administrativeAreaLevel5 ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:country ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:hasCountry ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:countryCode ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:complement ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:postalCode ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:addressType ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:latitude ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:longitude ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:fullAddress ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:landmark ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:instructions ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Address" ;
    rdfs:comment "A physical address with references to geographic locations" ;
    foundation:icon "home" ;
    rdfs:seeAlso """
Examples:
- Residential address
- Business address
- Mailing address
- Delivery address

An address combines a street, number, and geographic hierarchy
to uniquely identify a physical location.

Cardinality constraints:
All address components have maxCardinality 1 (single value per component).
""" .

# -----------------------------------------------------------------------------
# Address Properties - Geographic Components
# -----------------------------------------------------------------------------

# Street-level components
foundation:streetNumber a owl:DatatypeProperty ;
    rdfs:label "street number" ;
    rdfs:comment "Precise street number" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:streetNumber "1000" .
  :myAddress foundation:streetNumber "123-A" .
""" .

foundation:route a owl:DatatypeProperty ;
    rdfs:label "route" ;
    rdfs:comment "Named route or street name" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:route "Avenida Paulista" .
  :myAddress foundation:route "Fifth Avenue" .
""" .

# Locality components
foundation:neighborhood a owl:DatatypeProperty ;
    rdfs:label "neighborhood" ;
    rdfs:comment "Named neighborhood or district" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:neighborhood "Cambuí" .
  :myAddress foundation:neighborhood "SoHo" .
""" .

foundation:sublocality a owl:DatatypeProperty ;
    rdfs:label "sublocality" ;
    rdfs:comment "First-order civil entity below locality" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:sublocality "Brooklyn" .
""" .

foundation:locality a owl:DatatypeProperty ;
    rdfs:label "locality" ;
    rdfs:comment "Incorporated city or town" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:locality "Campinas" .
  :myAddress foundation:locality "New York" .
""" .

foundation:postalTown a owl:DatatypeProperty ;
    rdfs:label "postal town" ;
    rdfs:comment "Postal town (commonly used in UK and Sweden)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:postalTown "London" .
""" .

# Administrative areas (hierarchical levels vary by country)
foundation:administrativeAreaLevel1 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 1" ;
    rdfs:comment "First-order civil entity below country (typically state or province)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:administrativeAreaLevel1 "São Paulo" .
  :myAddress foundation:administrativeAreaLevel1 "California" .
""" .

foundation:administrativeAreaLevel2 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 2" ;
    rdfs:comment "Second-order civil entity below country (typically county)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:administrativeAreaLevel2 "Los Angeles County" .
""" .

foundation:administrativeAreaLevel3 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 3" ;
    rdfs:comment "Third-order civil entity below country" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string .

foundation:administrativeAreaLevel4 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 4" ;
    rdfs:comment "Fourth-order civil entity below country" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string .

foundation:administrativeAreaLevel5 a owl:DatatypeProperty ;
    rdfs:label "administrative area level 5" ;
    rdfs:comment "Fifth-order civil entity below country" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string .

# Country
foundation:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:comment "Country name" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:country "Brazil" .
  :myAddress foundation:country "United States" .
""" .

foundation:countryCode a owl:DatatypeProperty ;
    rdfs:label "country code" ;
    rdfs:comment "ISO 3166-1 alpha-2 country code" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:countryCode "BR" .
  :myAddress foundation:countryCode "US" .
""" .

foundation:complement a owl:DatatypeProperty ;
    rdfs:label "complement" ;
    rdfs:comment "Additional address details (apartment, suite, floor, etc.)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:complement "Apto 42" .
  :myAddress foundation:complement "Sala 1001" .
  :myAddress foundation:complement "3º andar" .
""" .

foundation:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code" ;
    rdfs:comment "Postal code or ZIP code" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :myAddress foundation:postalCode "13024-000" .  # CEP Brasil
  :myAddress foundation:postalCode "90210" .      # ZIP USA
""" .

foundation:addressType a owl:DatatypeProperty ;
    rdfs:label "address type" ;
    rdfs:comment "Type of address (residential, commercial, mailing, delivery)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:addressType "residential" .
  :businessAddress foundation:addressType "commercial" .
""" .

# -----------------------------------------------------------------------------
# Geographic Coordinates
# -----------------------------------------------------------------------------

foundation:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    rdfs:comment "Latitude coordinate (decimal degrees, -90 to 90)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:latitude -22.9068 .
""" .

foundation:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    rdfs:comment "Longitude coordinate (decimal degrees, -180 to 180)" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:longitude -47.0653 .
""" .

# -----------------------------------------------------------------------------
# Additional Address Properties
# -----------------------------------------------------------------------------

foundation:fullAddress a owl:DatatypeProperty ;
    rdfs:label "full address" ;
    rdfs:comment "Complete address as a single formatted string (for display purposes). This is derived from the location hierarchy and other address properties." ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:fullAddress "Av. Paulista, 1000 - Cambuí, Campinas - SP, 13024-000, Brasil" .

This string is typically computed from:
  - street name (from foundation:location)
  - streetNumber
  - complement
  - neighborhood, city, state, country (via foundation:isPartOf chain)
  - postalCode
""" .

foundation:landmark a owl:DatatypeProperty ;
    rdfs:label "landmark" ;
    rdfs:comment "Reference point or landmark near the address" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:landmark "Próximo ao shopping Iguatemi" .
""" .

foundation:instructions a owl:DatatypeProperty ;
    rdfs:label "instructions" ;
    rdfs:comment "Special delivery or access instructions" ;
    rdfs:domain foundation:Address ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myAddress foundation:instructions "Portão azul, tocar interfone apto 42" .
""" .

# -----------------------------------------------------------------------------
# Geographic Entity Object Properties (Preferred - Use These for New Code)
# -----------------------------------------------------------------------------
# These properties link addresses to structured geographic entities instead of
# using string literals. They enable proper geographic hierarchy navigation and
# querying. Use these in preference to the legacy string properties above.
# -----------------------------------------------------------------------------

foundation:hasStreet a owl:ObjectProperty ;
    rdfs:label "has street" ;
    rdfs:comment "Links address to a street entity (preferred over route string)" ;
    rdfs:domain foundation:Address ;
    rdfs:range foundation:Street ;
    rdfs:seeAlso """
This property should be used instead of foundation:route for new implementations.
It provides a reference to a structured Street entity rather than a string literal.

Example:
  :myAddress foundation:hasStreet :street_avenida_paulista .

  :street_avenida_paulista a foundation:Street ;
      foundation:streetName "Avenida Paulista" .

Benefits over string property:
- Enables street-level queries and navigation
- Supports street hierarchy (part of neighborhood/city)
- Allows street metadata (type, historical names, etc.)
""" .

foundation:hasNeighborhood a owl:ObjectProperty ;
    rdfs:label "has neighborhood" ;
    rdfs:comment "Links address to a neighborhood entity (preferred over neighborhood string)" ;
    rdfs:domain foundation:Address ;
    rdfs:range foundation:Neighborhood ;
    rdfs:seeAlso """
This property should be used instead of foundation:neighborhood for new implementations.
It provides a reference to a structured Neighborhood entity.

Example:
  :myAddress foundation:hasNeighborhood :neighborhood_cambui .

  :neighborhood_cambui a foundation:Neighborhood ;
      foundation:neighborhoodName "Cambuí" ;
      foundation:isPartOf :city_campinas .

Benefits over string property:
- Enables neighborhood hierarchy navigation
- Supports demographic and geographic data
- Facilitates location-based queries
""" .

foundation:hasCity a owl:ObjectProperty ;
    rdfs:label "has city" ;
    rdfs:comment "Links address to a city entity (preferred over locality/postalTown strings)" ;
    rdfs:domain foundation:Address ;
    rdfs:range foundation:City ;
    rdfs:seeAlso """
This property should be used instead of foundation:locality or foundation:postalTown
for new implementations. It provides a reference to a structured City entity.

Example:
  :myAddress foundation:hasCity :city_campinas .

  :city_campinas a foundation:City ;
      foundation:cityName "Campinas" ;
      foundation:isPartOf :state_sao_paulo .

Benefits over string property:
- Enables city-level hierarchy navigation
- Supports population, area, and other city data
- Facilitates geographic queries and aggregations
- Links to state/province and country entities
""" .

foundation:hasState a owl:ObjectProperty ;
    rdfs:label "has state" ;
    rdfs:comment "Links address to a state/province entity (preferred over administrativeAreaLevel1 string)" ;
    rdfs:domain foundation:Address ;
    rdfs:range foundation:State ;
    rdfs:seeAlso """
This property should be used instead of foundation:administrativeAreaLevel1
for new implementations. It provides a reference to a structured State entity.

Example:
  :myAddress foundation:hasState :state_sao_paulo .

  :state_sao_paulo a foundation:State ;
      foundation:stateName "São Paulo" ;
      foundation:stateCode "SP" ;
      foundation:isPartOf :country_brazil .

Benefits over string property:
- Enables state-level hierarchy navigation
- Supports state codes and metadata
- Facilitates regional queries and analysis
- Links to country entities
""" .

foundation:hasCountry a owl:ObjectProperty ;
    rdfs:label "has country" ;
    rdfs:comment "Links address to a country entity (preferred over country string)" ;
    rdfs:domain foundation:Address ;
    rdfs:range foundation:Country ;
    rdfs:seeAlso """
This property should be used instead of foundation:country for new implementations.
It provides a reference to a structured Country entity.

Example:
  :myAddress foundation:hasCountry :country_brazil .

  :country_brazil a foundation:Country ;
      foundation:countryName "Brazil" ;
      foundation:countryCode "BR" .

Note: Keep foundation:countryCode as a string identifier for ISO codes.

Benefits over string property:
- Enables country-level hierarchy navigation
- Supports country codes, currencies, languages
- Facilitates international queries and analysis
- Provides structured country metadata

Combined example with full hierarchy:
  :myAddress a foundation:Address ;
      foundation:streetNumber "2775" ;
      foundation:hasStreet :street_sete_setembro ;
      foundation:hasNeighborhood :neighborhood_reboucas ;
      foundation:hasCity :city_curitiba ;
      foundation:hasState :state_parana ;
      foundation:hasCountry :country_brazil ;
      foundation:postalCode "80230-010" .
""" .
