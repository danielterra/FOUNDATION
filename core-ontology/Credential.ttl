@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Credential
# =============================================================================
# Authentication or authorization information used to access a service or system
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:Credential a owl:Class ;
    rdfs:subClassOf foundation:InformationObject ,
        [ a owl:Restriction ;
          owl:onProperty foundation:credentialFor ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:ownedBy ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Credential" ;
    rdfs:comment "Abstract concept representing authentication or authorization information used to access a service or system" ;
    foundation:icon "key" ;
    rdfs:seeAlso """
Abstract class - use specific subclasses:
- APIKey: API keys for web services
- Password: Traditional username/password credentials
- Certificate: Digital certificates (X.509, SSL/TLS)
- Token: OAuth tokens, JWT, session tokens
- SSHKey: SSH public/private key pairs

Cardinality constraints:
- credentialFor: exactly 1 (required, credential must be for a specific service)
- ownedBy: exactly 1 (required, credential must belong to someone)
""" .

# -----------------------------------------------------------------------------
# Credential Properties
# -----------------------------------------------------------------------------

foundation:credentialFor a owl:ObjectProperty ;
    rdfs:label "credential for" ;
    rdfs:comment "The service or system that this credential provides access to" ;
    rdfs:domain foundation:Credential ;
    rdfs:range foundation:Service ;
    rdfs:seeAlso """
Example:
  :myClaudeApiKey foundation:credentialFor :ClaudeAIService .
  :myGitHubToken foundation:credentialFor :GitHubService .
""" .

foundation:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by" ;
    rdfs:comment "The person or agent who owns this credential" ;
    rdfs:domain foundation:Credential ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  :myClaudeApiKey foundation:ownedBy foundation:ThisUser .
""" .

foundation:credentialValue a owl:DatatypeProperty ;
    rdfs:label "credential value" ;
    rdfs:comment "The secret value of the credential (should be encrypted in production)" ;
    rdfs:domain foundation:Credential ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myClaudeApiKey foundation:credentialValue "sk-ant-..." .

Note: In production, this value should be encrypted at rest.
""" .

foundation:credentialCreatedAt a owl:DatatypeProperty ;
    rdfs:label "credential created at" ;
    rdfs:comment "When this credential was created or added to the system" ;
    rdfs:domain foundation:Credential ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso """
Example:
  :myClaudeApiKey foundation:credentialCreatedAt "2025-02-25T20:30:00Z"^^xsd:dateTime .
""" .

foundation:credentialExpiresAt a owl:DatatypeProperty ;
    rdfs:label "credential expires at" ;
    rdfs:comment "When this credential expires (optional, some credentials don't expire)" ;
    rdfs:domain foundation:Credential ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso """
Example:
  :myToken foundation:credentialExpiresAt "2026-02-25T20:30:00Z"^^xsd:dateTime .
""" .
