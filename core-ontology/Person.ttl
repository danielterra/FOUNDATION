@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# =============================================================================
# Person
# =============================================================================
# A human being
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:Person a owl:Class ;
    rdfs:subClassOf foundation:AgentCapacity , foundation:PhysicalThing ,
        [ a owl:Restriction ;
          owl:onProperty foundation:name ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:birthDate ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:birthPlace ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:father ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:mother ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:spouse ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:gender ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:sexualOrientation ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:maritalStatus ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:bloodType ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:height ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:weight ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:skinColor ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:residesAt ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Person" ;
    rdfs:comment "A human being (physical nature with agent capacity)" ;
    foundation:icon "person" ;
    rdfs:seeAlso """
Examples:
- Daniel Terra (developer)
- A team member
- A user of the system
- A project contributor

Cardinality constraints:
- name: exactly 1 (required unique identifier)
- birthDate: max 1 (optional, single date of birth)
- birthPlace: max 1 (optional, single birth location)
- father: max 1 (optional, single biological father)
- mother: max 1 (optional, single biological mother)
- spouse: max 1 (optional, single spouse)
- gender: max 1 (optional, single gender identity)
- sexualOrientation: max 1 (optional, single orientation)
- maritalStatus: max 1 (optional, single status)
- bloodType: max 1 (optional, single blood type)
- height: max 1 (optional, single height measurement)
- weight: max 1 (optional, single weight measurement)
- skinColor: max 1 (optional, single classification)
- residesAt: max 1 (optional, single primary residence)
- email: 0+ (optional, may have multiple email addresses)
- hasAddress: 0+ (optional, may have multiple addresses)
- nationality: 0+ (optional, may have multiple citizenships)
- hasDocument: 0+ (optional, may have multiple documents)
""" .

# -----------------------------------------------------------------------------
# Person Properties
# -----------------------------------------------------------------------------

foundation:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "The legal name of a person" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :john foundation:name "John Doe" .
""" .

# -----------------------------------------------------------------------------
# Social Attributes
# -----------------------------------------------------------------------------

foundation:socialName a owl:DatatypeProperty ;
    rdfs:label "social name" ;
    rdfs:comment "The name by which a person prefers to be called (may differ from legal name)" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :person foundation:name "João Silva" ;
           foundation:socialName "Maria Silva" .
""" .

foundation:nickname a owl:DatatypeProperty ;
    rdfs:label "nickname" ;
    rdfs:comment "Informal name or nickname" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :john foundation:nickname "Johnny" .
""" .

foundation:preferredPronouns a owl:DatatypeProperty ;
    rdfs:label "preferred pronouns" ;
    rdfs:comment "Personal pronouns the person prefers (e.g., ele/dele, ela/dela, elu/delu)" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :person foundation:preferredPronouns "ele/dele" .
  :person foundation:preferredPronouns "ela/dela" .
  :person foundation:preferredPronouns "elu/delu" .
""" .

foundation:gender a owl:ObjectProperty ;
    rdfs:label "gender" ;
    rdfs:comment "Gender identity" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Gender ;
    rdfs:seeAlso """
Example:
  :john foundation:gender foundation:GenderMale .
""" .

foundation:sexualOrientation a owl:ObjectProperty ;
    rdfs:label "sexual orientation" ;
    rdfs:comment "Sexual orientation" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:SexualOrientation ;
    rdfs:seeAlso """
Example:
  :person foundation:sexualOrientation foundation:SexualOrientationBisexual .
""" .

foundation:ethnicity a owl:DatatypeProperty ;
    rdfs:label "ethnicity" ;
    rdfs:comment "Ethnic or cultural identity" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :person foundation:ethnicity "Afro-Brazilian" .
""" .

foundation:maritalStatus a owl:ObjectProperty ;
    rdfs:label "marital status" ;
    rdfs:comment "Civil/marital status" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:MaritalStatus ;
    rdfs:seeAlso """
Example:
  :john foundation:maritalStatus foundation:MaritalStatusMarried .
""" .

# -----------------------------------------------------------------------------
# Physical Attributes
# -----------------------------------------------------------------------------

foundation:height a owl:DatatypeProperty ;
    rdfs:label "height" ;
    rdfs:comment "Height in meters" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:decimal ;
    qudt:hasUnit unit:M ;
    rdfs:seeAlso """
Example:
  :john foundation:height 1.75 .  # 1.75 meters
""" .

foundation:weight a owl:DatatypeProperty ;
    rdfs:label "weight" ;
    rdfs:comment "Weight in kilograms" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:decimal ;
    qudt:hasUnit unit:KiloGM ;
    rdfs:seeAlso """
Example:
  :john foundation:weight 75.5 .  # 75.5 kg
""" .

foundation:skinColor a owl:ObjectProperty ;
    rdfs:label "skin color" ;
    rdfs:comment "Skin color classification" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:SkinColor ;
    rdfs:seeAlso """
Example:
  :person foundation:skinColor foundation:SkinColorBrown .
""" .

foundation:bloodType a owl:ObjectProperty ;
    rdfs:label "blood type" ;
    rdfs:comment "ABO and Rh blood type" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:BloodType ;
    rdfs:seeAlso """
Example:
  :john foundation:bloodType foundation:BloodTypeOPositive .
""" .

foundation:eyeColor a owl:DatatypeProperty ;
    rdfs:label "eye color" ;
    rdfs:comment "Color of the eyes" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :john foundation:eyeColor "brown" .
""" .

foundation:hairColor a owl:DatatypeProperty ;
    rdfs:label "hair color" ;
    rdfs:comment "Color of the hair" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :john foundation:hairColor "black" .
""" .

# -----------------------------------------------------------------------------
# Biographical Information
# -----------------------------------------------------------------------------

foundation:birthDate a owl:DatatypeProperty ;
    rdfs:label "birth date" ;
    rdfs:comment "Date of birth" ;
    rdfs:domain foundation:Person ;
    rdfs:range xsd:date ;
    rdfs:seeAlso """
Example:
  :john foundation:birthDate "1990-05-15"^^xsd:date .
""" .

foundation:birthPlace a owl:ObjectProperty ;
    rdfs:label "birth place" ;
    rdfs:comment "City where the person was born" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:City ;
    rdfs:seeAlso """
Example:
  :john foundation:birthPlace :campinas .
""" .

foundation:nationality a owl:ObjectProperty ;
    rdfs:label "nationality" ;
    rdfs:comment "Country of citizenship" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Country ;
    rdfs:seeAlso """
Example:
  :john foundation:nationality :brazil .
""" .

# -----------------------------------------------------------------------------
# Document Relationships
# -----------------------------------------------------------------------------

foundation:hasDocument a owl:ObjectProperty ;
    rdfs:label "has document" ;
    rdfs:comment "Identification document owned by the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:IdentificationDocument ;
    rdfs:seeAlso """
Example:
  :john foundation:hasDocument :johnRG ;
        foundation:hasDocument :johnCPF ;
        foundation:hasDocument :johnPassport .
""" .

# -----------------------------------------------------------------------------
# Address Relationships
# -----------------------------------------------------------------------------

foundation:hasAddress a owl:ObjectProperty ;
    rdfs:label "has address" ;
    rdfs:comment "Address associated with a person or organization" ;
    rdfs:range foundation:Address ;
    rdfs:seeAlso """
Example:
  :john foundation:hasAddress :homeAddress ;
        foundation:hasAddress :workAddress .

  :acmeCompany foundation:hasAddress :companyAddress .
""" .

foundation:residesAt a owl:ObjectProperty ;
    rdfs:label "resides at" ;
    rdfs:comment "Primary residential address" ;
    rdfs:subPropertyOf foundation:hasAddress ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Address ;
    rdfs:seeAlso """
Example:
  :john foundation:residesAt :homeAddress .
""" .

# -----------------------------------------------------------------------------
# Family Relationships
# -----------------------------------------------------------------------------

foundation:father a owl:ObjectProperty ;
    rdfs:label "father" ;
    rdfs:comment "Father of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:father :robert .
""" .

foundation:mother a owl:ObjectProperty ;
    rdfs:label "mother" ;
    rdfs:comment "Mother of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:mother :mary .
""" .

foundation:son a owl:ObjectProperty ;
    rdfs:label "son" ;
    rdfs:comment "Son of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :mary foundation:son :john .
""" .

foundation:daughter a owl:ObjectProperty ;
    rdfs:label "daughter" ;
    rdfs:comment "Daughter of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :mary foundation:daughter :jane .
""" .

foundation:brother a owl:ObjectProperty ;
    rdfs:label "brother" ;
    rdfs:comment "Brother of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :jane foundation:brother :john .
""" .

foundation:sister a owl:ObjectProperty ;
    rdfs:label "sister" ;
    rdfs:comment "Sister of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:sister :jane .
""" .

foundation:spouse a owl:ObjectProperty ;
    rdfs:label "spouse" ;
    rdfs:comment "Spouse of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:spouse :mary .
""" .

foundation:partner a owl:ObjectProperty ;
    rdfs:label "partner" ;
    rdfs:comment "Domestic partner or significant other" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:partner :mary .
""" .

foundation:stepfather a owl:ObjectProperty ;
    rdfs:label "stepfather" ;
    rdfs:comment "Stepfather of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:stepfather :carlos .
""" .

foundation:stepmother a owl:ObjectProperty ;
    rdfs:label "stepmother" ;
    rdfs:comment "Stepmother of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:stepmother :ana .
""" .

foundation:godfather a owl:ObjectProperty ;
    rdfs:label "godfather" ;
    rdfs:comment "Godfather of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:godfather :paulo .
""" .

foundation:godmother a owl:ObjectProperty ;
    rdfs:label "godmother" ;
    rdfs:comment "Godmother of the person" ;
    rdfs:domain foundation:Person ;
    rdfs:range foundation:Person ;
    rdfs:seeAlso """
Example:
  :john foundation:godmother :lucia .
""" .
