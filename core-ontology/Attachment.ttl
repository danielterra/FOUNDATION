@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Attachment - File attached to messages
# =============================================================================
# Represents files, images, documents attached to messages sent to AI
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:Attachment a owl:Class ;
    rdfs:subClassOf foundation:DigitalThing ;
    rdfs:label "Attachment"@en ;
    rdfs:label "Anexo"@pt ;
    rdfs:comment "A file attached to a message for AI processing. Links a File to a Message with AI-specific metadata." ;
    foundation:icon "attach_file" ;
    rdfs:seeAlso """
Examples:
- Image sent to Claude for vision analysis (PNG, JPEG, WebP, GIF)
- PDF document for text extraction and analysis
- Screenshot for debugging assistance
- Diagram for architecture review

Supported formats:
- Images: PNG, JPEG, WebP, GIF (for Claude Vision)
- Documents: PDF (for Claude PDF support via Files API)
- Text: TXT, MD, CSV (converted to text in prompt)

Architecture:
- Attachment connects a File to a Message
- File contains metadata (path, size, type, hash)
- Attachment adds AI-specific data (base64, fileId for Claude API)
""" .

# -----------------------------------------------------------------------------
# Attachment Properties
# -----------------------------------------------------------------------------

foundation:attachesFile a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "attaches file"@en ;
    rdfs:label "anexa arquivo"@pt ;
    rdfs:comment "Links the attachment to the actual File being attached" ;
    rdfs:domain foundation:Attachment ;
    rdfs:range foundation:File ;
    rdfs:seeAlso """
Example:
  :attachment1 foundation:attachesFile :myScreenshot .

  :myScreenshot a foundation:File ;
      foundation:fileName "screenshot.png" ;
      foundation:filePath "file:///uploads/screenshot.png"^^xsd:anyURI ;
      foundation:hasFileType foundation:FileType_PNG ;
      foundation:fileSize 524288 .
""" .

foundation:attachedToMessage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "attached to message"@en ;
    rdfs:label "anexado à mensagem"@pt ;
    rdfs:comment "Links the attachment to the Message it belongs to" ;
    rdfs:domain foundation:Attachment ;
    rdfs:range foundation:Message ;
    rdfs:seeAlso """
Example:
  :attachment1 foundation:attachedToMessage :userMessage123 .
""" .

foundation:attachedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "attached at"@en ;
    rdfs:label "anexado em"@pt ;
    rdfs:comment "Timestamp when the file was attached to the message" ;
    rdfs:domain foundation:Attachment ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso """
Example:
  :attachment1 foundation:attachedAt "2025-02-27T15:30:00Z"^^xsd:dateTime .
""" .

# -----------------------------------------------------------------------------
# AI-Specific Properties (Claude API)
# -----------------------------------------------------------------------------

foundation:claudeFileId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "Claude file ID"@en ;
    rdfs:label "ID de arquivo Claude"@pt ;
    rdfs:comment "Claude Files API file ID for uploaded PDFs (optional, for reuse across messages)" ;
    rdfs:domain foundation:Attachment ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :attachment1 foundation:claudeFileId "file-abc123xyz" .

Used when files are uploaded via Claude Files API (Beta) for reuse across messages.
Only applicable for PDF files using the Files API.
""" .
