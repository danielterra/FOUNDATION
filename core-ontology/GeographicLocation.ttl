@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# GeographicLocation (Parent Class)
# =============================================================================
# Base class for hierarchical geographic locations
#
# Version: 0.1.0
# License: MIT
# =============================================================================

foundation:GeographicLocation a owl:Class ;
    rdfs:subClassOf foundation:Concept ;
    rdfs:label "Geographic Location" ;
    rdfs:comment "A geographic location in a hierarchical structure" ;
    foundation:icon "location_on" ;
    rdfs:seeAlso """
Examples:
- Brazil (country)
- São Paulo (state)
- Campinas (city)
- Cambuí (neighborhood)
- Avenida Paulista (street)
""" .

# -----------------------------------------------------------------------------
# Hierarchical Relationships
# -----------------------------------------------------------------------------

foundation:isPartOf a owl:ObjectProperty ;
    rdfs:label "is part of" ;
    rdfs:comment "Indicates that a geographic location is part of a larger location" ;
    rdfs:domain foundation:GeographicLocation ;
    rdfs:range foundation:GeographicLocation ;
    rdfs:seeAlso """
Examples:
  :saoPaulo foundation:isPartOf :brazil .
  :campinas foundation:isPartOf :saoPaulo .
  :cambui foundation:isPartOf :campinas .
  :avPaulista foundation:isPartOf :cambui .
""" .

foundation:contains a owl:ObjectProperty ;
    rdfs:label "contains" ;
    rdfs:comment "Inverse of isPartOf - indicates that a location contains another" ;
    owl:inverseOf foundation:isPartOf ;
    rdfs:domain foundation:GeographicLocation ;
    rdfs:range foundation:GeographicLocation ;
    rdfs:seeAlso """
Examples:
  :brazil foundation:contains :saoPaulo .
  :saoPaulo foundation:contains :campinas .
""" .
