@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# EmailAddress
# =============================================================================
# An email address for electronic mail communication
#
# Version: 0.1.0
# License: MIT
# =============================================================================

# -----------------------------------------------------------------------------
# EmailAddress Class
# -----------------------------------------------------------------------------

foundation:EmailAddress a owl:Class ;
    rdfs:subClassOf foundation:Concept ,
        [ a owl:Restriction ;
          owl:onProperty foundation:emailAddress ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:emailType ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:isPrimary ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:isVerified ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Email Address" ;
    rdfs:comment "An email address for electronic mail communication" ;
    foundation:icon "email" ;
    rdfs:seeAlso """
Represents an email address that can be associated with people, companies, or services.

Email addresses follow the format: local-part@domain

Cardinality constraints:
- emailAddress: exactly 1 (required - the actual email address)
- emailType: 0-1 (optional classification)
- isPrimary: 0-1 (optional flag)
- isVerified: 0-1 (optional flag)

Example:
  :johnEmail a foundation:EmailAddress ;
      foundation:emailAddress "john.doe@example.com" ;
      foundation:emailType "Personal" ;
      foundation:isPrimary true .

  :companyEmail a foundation:EmailAddress ;
      foundation:emailAddress "contact@acme.com" ;
      foundation:emailType "Business" ;
      foundation:isPrimary true .
""" .

# -----------------------------------------------------------------------------
# EmailAddress Properties
# -----------------------------------------------------------------------------

foundation:emailAddress a owl:DatatypeProperty ;
    rdfs:label "email address" ;
    rdfs:comment "The complete email address" ;
    rdfs:domain foundation:EmailAddress ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Format: local-part@domain

Examples:
  :email1 foundation:emailAddress "john.doe@example.com" .
  :email2 foundation:emailAddress "contact@acme.com" .
  :email3 foundation:emailAddress "support+tickets@service.com" .
""" .

foundation:emailType a owl:DatatypeProperty ;
    rdfs:label "email type" ;
    rdfs:comment "Type or category of the email address" ;
    rdfs:domain foundation:EmailAddress ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Common types:
- Personal
- Business / Work
- School / Academic
- Support
- Sales
- No-reply

Example:
  :email1 foundation:emailType "Personal" .
  :email2 foundation:emailType "Business" .
""" .

foundation:isPrimary a owl:DatatypeProperty ;
    rdfs:label "is primary" ;
    rdfs:comment "Indicates if this is the primary/default email address" ;
    rdfs:domain foundation:EmailAddress ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """
Example:
  :email1 foundation:isPrimary true .
  :email2 foundation:isPrimary false .
""" .

foundation:isVerified a owl:DatatypeProperty ;
    rdfs:label "is verified" ;
    rdfs:comment "Indicates if the email address has been verified" ;
    rdfs:domain foundation:EmailAddress ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """
Example:
  :email1 foundation:isVerified true .
  :email2 foundation:isVerified false .
""" .

# -----------------------------------------------------------------------------
# EmailAddress Object Properties
# -----------------------------------------------------------------------------

foundation:hasEmailAddress a owl:ObjectProperty ;
    rdfs:label "has email address" ;
    rdfs:comment "Links a person or organization to an email address (can have multiple)" ;
    rdfs:domain foundation:AgentCapacity ;
    rdfs:range foundation:EmailAddress ;
    rdfs:seeAlso """
An entity can have multiple email addresses (personal, work, support, sales, etc.).

Can be used with:
- foundation:Person (personal or work email)
- foundation:Company or foundation:Organization (business email)

Examples:
  :john foundation:hasEmailAddress :johnPersonalEmail ;
        foundation:hasEmailAddress :johnWorkEmail ;
        foundation:hasEmailAddress :johnGitHubEmail .

  :acmeCompany foundation:hasEmailAddress :acmeContactEmail ;
               foundation:hasEmailAddress :acmeSupportEmail ;
               foundation:hasEmailAddress :acmeSalesEmail .
""" .
