@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# AIConversationMessage - Messages in AI Conversations
# =============================================================================
# A specialized message type for conversations with AI assistants (LLMs)
# Supports structured content blocks (text, images, tool_use, tool_result)
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

<http://foundation.local/ontology/AIConversationMessage>
  a owl:Ontology ;
  rdfs:label "AI Conversation Message Ontology" ;
  rdfs:comment "Defines AIConversationMessage class for LLM conversations" ;
  owl:imports <http://foundation.local/ontology/Message> ;
.

foundation:AIConversationMessage a owl:Class ;
    rdfs:subClassOf foundation:Message ,
        [ a owl:Restriction ;
          owl:onProperty foundation:role ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "AI Conversation Message" ;
    rdfs:comment "A message in a conversation with an AI assistant (LLM). Used for both user messages and assistant responses. Supports structured content blocks including text, images, tool calls, and tool results." ;
    foundation:icon "smart_toy" ;
    rdfs:seeAlso """
Examples:
- User asks: "What's the weather in SF?"
- Assistant responds with tool use
- User provides tool results
- Assistant gives final answer

This class is LLM-agnostic and works with:
- Claude (Anthropic)
- GPT (OpenAI)
- Gemini (Google)
- Any other LLM that uses similar message/content block patterns

Key differences from base Message class:
- content: JSON array of content blocks (not plain text)
- role: "user" or "assistant" (required)
- Supports tool use pattern (tool_use + tool_result blocks)
- Token tracking for usage/billing

Cardinality constraints:
- role: exactly 1 (required - "user" or "assistant")
- content: 1 (required - JSON array of content blocks)
- tokenCount: 0-1 (optional but recommended for performance)
- model: 0-1 (optional, only for assistant messages)
- stopReason: 0-1 (optional, only for assistant messages)
""" .

# -----------------------------------------------------------------------------
# AI Conversation Specific Properties
# -----------------------------------------------------------------------------

foundation:role a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "role" ;
    rdfs:comment "The role of the message sender in the conversation: 'user' or 'assistant'" ;
    rdfs:domain foundation:AIConversationMessage ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :msg1 foundation:role "user" .
  :msg2 foundation:role "assistant" .

Required for all AIConversationMessage instances.
Valid values: "user", "assistant"

Note: This is different from foundation:sender which points to the actual agent.
Role is a simple string used by LLM APIs.
""" .

# -----------------------------------------------------------------------------
# Override content property for AIConversationMessage
# -----------------------------------------------------------------------------
# Note: foundation:content is already defined in Message.ttl as a generic string property.
# For AIConversationMessage, content MUST contain a JSON array of content blocks.
# The rdfs:seeAlso here provides AIConversationMessage-specific documentation.

foundation:content rdfs:seeAlso """
For AIConversationMessage, content MUST be a JSON string containing an array of content blocks.

Content Block Types:
1. Text block:
   {"type": "text", "text": "Hello, how can I help?"}

2. Image block:
   {"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": "iVBOR..."}}

3. Document block (PDF):
   {"type": "document", "source": {"type": "base64", "media_type": "application/pdf", "data": "JVBERi..."}}

4. Tool use block (assistant only):
   {"type": "tool_use", "id": "toolu_01A23B", "name": "get_weather", "input": {"location": "SF"}}

5. Tool result block (user only):
   {"type": "tool_result", "tool_use_id": "toolu_01A23B", "content": "72°F, sunny", "is_error": false}

Examples:

# User message with text only:
:msg1 a foundation:AIConversationMessage ;
    foundation:role "user" ;
    foundation:content "[{\"type\":\"text\",\"text\":\"What's the weather in SF?\"}]" .

# Assistant message with text and tool use:
:msg2 a foundation:AIConversationMessage ;
    foundation:role "assistant" ;
    foundation:content "[{\"type\":\"text\",\"text\":\"Let me check\"},{\"type\":\"tool_use\",\"id\":\"toolu_123\",\"name\":\"get_weather\",\"input\":{\"location\":\"San Francisco\"}}]" ;
    foundation:stopReason "tool_use" .

# User message with tool result:
:msg3 a foundation:AIConversationMessage ;
    foundation:role "user" ;
    foundation:content "[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_123\",\"content\":\"72°F, sunny\",\"is_error\":false}]" .

# Assistant final response:
:msg4 a foundation:AIConversationMessage ;
    foundation:role "assistant" ;
    foundation:content "[{\"type\":\"text\",\"text\":\"It's 72°F and sunny in San Francisco!\"}]" ;
    foundation:stopReason "end_turn" .

This format is compatible with both Claude (Anthropic) and OpenAI APIs.
""" .

# -----------------------------------------------------------------------------
# AI Usage Tracking Properties
# -----------------------------------------------------------------------------
# Note: These properties are inherited from Message.ttl but documented here
# for clarity in the context of AI conversations.

foundation:tokenCount rdfs:seeAlso """
For AIConversationMessage: Total tokens in this message's content blocks.
Calculated once at message creation for performance optimization.

Includes tokens from:
- Text blocks
- Tool use blocks (name + input JSON)
- Tool result blocks (content)
- Image/document metadata (file references)

Used for history loading with token budget constraints.
""" .

foundation:model rdfs:seeAlso """
For AIConversationMessage: The LLM that generated this message.

Examples:
  :msg1 foundation:model "claude-opus-4-6" .
  :msg2 foundation:model "gpt-4-turbo" .
  :msg3 foundation:model "gemini-pro" .

Only applicable to assistant messages (role="assistant").
User messages don't have a model property.
""" .

foundation:stopReason rdfs:seeAlso """
For AIConversationMessage: Why the LLM stopped generating.

Valid values:
- "end_turn": Natural completion (finished response)
- "tool_use": Stopped to execute tools
- "max_tokens": Hit token limit
- "stop_sequence": Hit configured stop sequence

Examples:
  # Natural completion:
  :msg1 foundation:stopReason "end_turn" .

  # Needs tool execution:
  :msg2 foundation:stopReason "tool_use" .

  # Hit limit:
  :msg3 foundation:stopReason "max_tokens" .

Only applicable to assistant messages (role="assistant").

Critical for control flow: If stopReason="tool_use", the system must:
1. Parse tool_use blocks from content
2. Execute the tools
3. Create user message with tool_result blocks
4. Continue conversation
""" .

foundation:inputTokens rdfs:seeAlso """
For AIConversationMessage: Input tokens consumed to generate this message.

Only applicable to assistant messages.
Used for usage tracking and billing.

Example:
  :msg1 foundation:inputTokens 2450 .
""" .

foundation:outputTokens rdfs:seeAlso """
For AIConversationMessage: Output tokens generated in this message.

Only applicable to assistant messages.
Used for usage tracking and billing.

Example:
  :msg1 foundation:outputTokens 156 .
""" .

foundation:cacheCreationInputTokens rdfs:seeAlso """
For AIConversationMessage: Tokens used to create prompt cache.

Optional - only used if LLM supports prompt caching (e.g., Claude).
Charged at higher rate (e.g., 1.25x for Claude).

Example:
  :msg1 foundation:cacheCreationInputTokens 5000 .
""" .

foundation:cacheReadInputTokens rdfs:seeAlso """
For AIConversationMessage: Tokens read from prompt cache.

Optional - only used if LLM supports prompt caching (e.g., Claude).
Charged at lower rate (e.g., 0.1x for Claude - 90% savings).

Example:
  :msg1 foundation:cacheReadInputTokens 5000 .
""" .
