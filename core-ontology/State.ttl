@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# State
# =============================================================================
# State, province, or first-level administrative division
#
# Version: 0.1.0
# License: MIT
# =============================================================================

foundation:State a owl:Class ;
    rdfs:subClassOf foundation:GeographicLocation ;
    rdfs:label "State" ;
    rdfs:comment "A state, province, or first-level administrative division" ;
    foundation:icon "map" ;
    rdfs:seeAlso """
Examples:
- São Paulo (SP, Brazil)
- California (CA, USA)
- Ontario (ON, Canada)
""" .

# -----------------------------------------------------------------------------
# State Properties
# -----------------------------------------------------------------------------

foundation:stateCode a owl:DatatypeProperty ;
    rdfs:label "state code" ;
    rdfs:comment "Official state/province code (e.g., SP, CA, ON)" ;
    rdfs:domain foundation:State ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :saoPaulo foundation:stateCode "SP" .
""" .

foundation:stateName a owl:DatatypeProperty ;
    rdfs:label "state name" ;
    rdfs:comment "Official name of the state or province" ;
    rdfs:domain foundation:State ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :saoPaulo foundation:stateName "São Paulo" .
""" .
