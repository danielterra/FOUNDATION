@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix currency: <http://qudt.org/vocab/currency/> .

# =============================================================================
# Contract
# =============================================================================
# A legally binding agreement between two or more parties
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

<http://foundation.local/ontology/Contract>
  a owl:Ontology ;
  rdfs:label "FOUNDATION Contract Ontology" ;
  rdfs:comment "Contract and agreement concepts" ;
  owl:imports <http://qudt.org/2.1/vocab/currency> ;
.

foundation:Contract a owl:Class ;
    rdfs:subClassOf foundation:InformationObject ;
    rdfs:label "Contract" ;
    rdfs:comment "A legally binding agreement between two or more parties, establishing rights and obligations" ;
    foundation:icon "description" ;
    rdfs:seeAlso """
A contract is a formal agreement that creates legal obligations between parties.

Examples:
- Employment contracts
- Service contracts
- Sales contracts
- Rental/lease agreements
- License agreements
- Non-disclosure agreements (NDAs)

Key characteristics:
- Has defined parties (contractor, contractee)
- Has start and potentially end dates
- May have financial terms
- May include specific obligations and deliverables
""" .

# -----------------------------------------------------------------------------
# Contract Properties
# -----------------------------------------------------------------------------

foundation:contractNumber a owl:DatatypeProperty ;
    rdfs:label "contract number" ;
    rdfs:comment "Unique identifier or reference number for the contract" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:contractNumber "CTR-2024-001" .
""" .

foundation:contractTitle a owl:DatatypeProperty ;
    rdfs:label "contract title" ;
    rdfs:comment "Title or subject of the contract" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:contractTitle "Software Development Services Agreement" .
""" .

foundation:contractStartDate a owl:DatatypeProperty ;
    rdfs:label "contract start date" ;
    rdfs:comment "Date when the contract becomes effective" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:date ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:contractStartDate "2024-01-01"^^xsd:date .
""" .

foundation:contractEndDate a owl:DatatypeProperty ;
    rdfs:label "contract end date" ;
    rdfs:comment "Date when the contract expires or is terminated (if applicable)" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:date ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:contractEndDate "2024-12-31"^^xsd:date .
""" .

foundation:contractValue a owl:DatatypeProperty ;
    rdfs:label "contract value" ;
    rdfs:comment "Total monetary value of the contract" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:contractValue "50000.00"^^xsd:decimal ;
      foundation:contractCurrency currency:USD .
""" .

foundation:contractCurrency a owl:ObjectProperty ;
    rdfs:label "contract currency" ;
    rdfs:comment "Currency (QUDT CurrencyUnit) for the contract value" ;
    rdfs:domain foundation:Contract ;
    rdfs:range qudt:CurrencyUnit ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:contractCurrency currency:USD .
  :contract2 foundation:contractCurrency currency:BRL .
  :contract3 foundation:contractCurrency currency:EUR .
""" .

foundation:contractStatus a owl:DatatypeProperty ;
    rdfs:label "contract status" ;
    rdfs:comment "Current status of the contract (draft, active, completed, terminated, etc.)" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Common statuses:
- Draft
- Under Review
- Active
- Suspended
- Completed
- Terminated
- Expired

Example:
  :contract1 foundation:contractStatus "Active" .
""" .

foundation:renewalTerms a owl:DatatypeProperty ;
    rdfs:label "renewal terms" ;
    rdfs:comment "Terms and conditions for contract renewal" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:renewalTerms "Automatically renews for one year unless terminated 30 days prior to expiration" .
""" .

foundation:terminationClause a owl:DatatypeProperty ;
    rdfs:label "termination clause" ;
    rdfs:comment "Conditions under which the contract can be terminated" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:terminationClause "Either party may terminate with 30 days written notice" .
""" .

foundation:contractTerms a owl:DatatypeProperty ;
    rdfs:label "contract terms" ;
    rdfs:comment "Full text or summary of the contract terms and conditions" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:contractTerms "The contractor shall provide software development services..." .
""" .

foundation:signatureDate a owl:DatatypeProperty ;
    rdfs:label "signature date" ;
    rdfs:comment "Date when the contract was signed" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:date ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:signatureDate "2023-12-15"^^xsd:date .
""" .

# -----------------------------------------------------------------------------
# Contract Relationships (Object Properties)
# -----------------------------------------------------------------------------

foundation:contractParty a owl:ObjectProperty ;
    rdfs:label "contract party" ;
    rdfs:comment "A party (person or organization) involved in the contract" ;
    rdfs:domain foundation:Contract ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:contractParty :johnDoe .
  :contract1 foundation:contractParty :acmeCorp .
""" .

foundation:contractor a owl:ObjectProperty ;
    rdfs:subPropertyOf foundation:contractParty ;
    rdfs:label "contractor" ;
    rdfs:comment "The party providing services or goods under the contract" ;
    rdfs:domain foundation:Contract ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  :serviceContract foundation:contractor :freelanceDeveloper .
""" .

foundation:contractee a owl:ObjectProperty ;
    rdfs:subPropertyOf foundation:contractParty ;
    rdfs:label "contractee" ;
    rdfs:comment "The party receiving services or goods under the contract (client)" ;
    rdfs:domain foundation:Contract ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  :serviceContract foundation:contractee :clientCompany .
""" .

foundation:governingLaw a owl:DatatypeProperty ;
    rdfs:label "governing law" ;
    rdfs:comment "The jurisdiction or legal framework that governs the contract" ;
    rdfs:domain foundation:Contract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:governingLaw "State of California, USA" .
  :contract2 foundation:governingLaw "Brazilian Civil Code" .
""" .

foundation:hasAttachment a owl:ObjectProperty ;
    rdfs:label "has attachment" ;
    rdfs:comment "Links a contract to attached documents (PDF, signed copies, etc.)" ;
    rdfs:domain foundation:Contract ;
    rdfs:range foundation:Attachment ;
    rdfs:seeAlso """
Example:
  :contract1 foundation:hasAttachment :signedPdfFile .
""" .
