@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Thing
# =============================================================================
# Universal properties that apply to every thing in the ontology
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

# -----------------------------------------------------------------------------
# Thing Properties (domain: owl:Thing)
# -----------------------------------------------------------------------------

foundation:hasStatus a owl:ObjectProperty ;
    rdfs:label "has status" ;
    rdfs:comment "The current state of work" ;
    rdfs:domain owl:Thing ;
    rdfs:range foundation:Status .

foundation:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on" ;
    rdfs:comment "Indicates a dependency between work items" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

foundation:contributesTo a owl:ObjectProperty ;
    rdfs:label "contributes to" ;
    rdfs:comment "Links this thing to anything it contributes to" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .
