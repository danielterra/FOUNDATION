@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Task
# =============================================================================
# A specific action to be completed
#
# Version: 0.2.0
# License: GNU GPL
# =============================================================================

<http://foundation.local/ontology/Task>
    a owl:Ontology ;
    owl:imports <http://foundation.local/ontology/Status> ,
                <http://foundation.local/ontology/Person> ,
                <http://foundation.local/ontology/File> .

foundation:Task a owl:Class ;
    rdfs:subClassOf foundation:Process ;
    rdfs:label "Task" ;
    rdfs:comment "A specific action to be completed with scheduling, dependencies, and tracking capabilities" ;
    foundation:icon "check_circle" ;
    rdfs:seeAlso """
Examples:
- Create Agent.ttl file
- Add examples to all ontology classes
- Run npm run build:db
- Update README with new features
- Fix circular dependency bug
- Weekly team meeting
- Deploy to production
- Review pull request #123
""" .

# -----------------------------------------------------------------------------
# Task Status & Priority
# -----------------------------------------------------------------------------

foundation:status a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:comment "Current status of the task (Pending, Blocked, In Progress, Completed, Paused, Rejected)" ;
    rdfs:domain foundation:Task ;
    rdfs:range foundation:Status .

foundation:TaskPriority a owl:Class ;
    rdfs:label "Task Priority" ;
    rdfs:comment "Priority level for a task" ;
    owl:oneOf ( foundation:HighPriority foundation:MediumPriority foundation:LowPriority ) .

foundation:HighPriority a foundation:TaskPriority ;
    rdfs:label "High Priority" .

foundation:MediumPriority a foundation:TaskPriority ;
    rdfs:label "Medium Priority" .

foundation:LowPriority a foundation:TaskPriority ;
    rdfs:label "Low Priority" .

foundation:priority a owl:ObjectProperty ;
    rdfs:label "priority" ;
    rdfs:comment "Priority level: High, Medium, or Low" ;
    rdfs:domain foundation:Task ;
    rdfs:range foundation:TaskPriority .

# -----------------------------------------------------------------------------
# Task Scheduling & Time Management
# -----------------------------------------------------------------------------

foundation:startedAt a owl:DatatypeProperty ;
    rdfs:label "started at" ;
    rdfs:comment "When the task was started" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:dateTime .

foundation:completedAt a owl:DatatypeProperty ;
    rdfs:label "completed at" ;
    rdfs:comment "When the task was completed" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:dateTime .

foundation:dueDate a owl:DatatypeProperty ;
    rdfs:label "due date" ;
    rdfs:comment "Deadline for task completion" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:date .

foundation:scheduledFor a owl:DatatypeProperty ;
    rdfs:label "scheduled for" ;
    rdfs:comment "Planned date and time for task execution" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:dateTime .

foundation:reminderAt a owl:DatatypeProperty ;
    rdfs:label "reminder at" ;
    rdfs:comment "Date and time to trigger a reminder" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:dateTime .

foundation:estimatedEffort a owl:DatatypeProperty ;
    rdfs:label "estimated effort" ;
    rdfs:comment "Estimated time to complete the task (ISO 8601 duration format, e.g., PT1H30M)" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:duration .

foundation:recurrence a owl:DatatypeProperty ;
    rdfs:label "recurrence" ;
    rdfs:comment "Recurrence pattern in iCalendar RRULE format (e.g., RRULE:FREQ=WEEKLY;BYDAY=MO)" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "RFC 5545 (iCalendar)" .

# -----------------------------------------------------------------------------
# Task Assignment & People
# -----------------------------------------------------------------------------

foundation:assignedTo a owl:ObjectProperty ;
    rdfs:label "assigned to" ;
    rdfs:comment "Person responsible for executing the task. When the task is completed (has completedAt), this indicates who performed it." ;
    rdfs:domain foundation:Task ;
    rdfs:range foundation:Person .

# -----------------------------------------------------------------------------
# Task Relationships
# -----------------------------------------------------------------------------

foundation:relatedTo a owl:ObjectProperty ;
    rdfs:label "related to" ;
    rdfs:comment "Links the task to any related entity" ;
    rdfs:domain foundation:Task ;
    rdfs:range owl:Thing .

# -----------------------------------------------------------------------------
# Task Location & Context
# -----------------------------------------------------------------------------

foundation:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    rdfs:comment "Physical or virtual location where the task takes place" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:string .

foundation:locationTrigger a owl:DatatypeProperty ;
    rdfs:label "location trigger" ;
    rdfs:comment "Trigger type for location-based reminders: 'arriving' or 'leaving'" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:string ;
    rdfs:seeAlso "Values: arriving, leaving" .

# -----------------------------------------------------------------------------
# Task Content & Documentation
# -----------------------------------------------------------------------------

foundation:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "Detailed description of the task" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:string .

foundation:notes a owl:DatatypeProperty ;
    rdfs:label "notes" ;
    rdfs:comment "Free-form notes and annotations about the task" ;
    rdfs:domain foundation:Task ;
    rdfs:range xsd:string .

foundation:attachments a owl:ObjectProperty ;
    rdfs:label "attachments" ;
    rdfs:comment "Files related to the task" ;
    rdfs:domain foundation:Task ;
    rdfs:range foundation:File .
