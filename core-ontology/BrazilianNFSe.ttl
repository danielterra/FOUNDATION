@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix currency: <http://qudt.org/vocab/currency/> .

# =============================================================================
# Brazilian NFS-e (Nota Fiscal de Serviço Eletrônica)
# =============================================================================
# Brazilian electronic service invoice system
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

<http://foundation.local/ontology/BrazilianNFSe>
  a owl:Ontology ;
  rdfs:label "FOUNDATION Brazilian NFS-e Ontology" ;
  rdfs:comment "Brazilian electronic service invoice (Nota Fiscal de Serviço Eletrônica)" ;
  owl:imports <http://foundation.local/ontology/Invoice> ,
              <http://foundation.local/ontology/Company> ,
              <http://foundation.local/ontology/City> ,
              <http://foundation.local/ontology/EmailAddress> ,
              <http://foundation.local/ontology/PhoneNumber> ,
              <http://foundation.local/ontology/File> ,
              <http://qudt.org/2.1/vocab/currency> ;
.

# -----------------------------------------------------------------------------
# BrazilianNFSe - Main Class
# -----------------------------------------------------------------------------

foundation:BrazilianNFSe a owl:Class ;
    rdfs:subClassOf foundation:Invoice ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseAccessKey ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseNumber ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseCompetenceDate ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseEmissionDateTime ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseIssuerMunicipality ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseServiceProvider ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseServiceTaker ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseServiceDescription ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseServiceValue ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseNetValue ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:dpsNumber ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:dpsSeries ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:dpsEmissionDateTime ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseTaxationCode ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseMunicipalTaxationCode ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseServiceLocation ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseISSQNTaxation ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseISSQNRetention ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseISSQNValue ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseISSQNBaseCalculation ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseISSQNRate ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseISSQNMunicipality ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseIRRF ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseSocialSecurityContribution ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseSocialContributions ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfsePIS ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseCOFINS ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseConditionalDiscount ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseUnconditionalDiscount ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseDeductions ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseTotalFederalRetentions ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseSimplesNacionalOptant ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseTaxRegime ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseSpecialTaxRegime ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseComplementaryInfo ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseApproximateTaxesFederal ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseApproximateTaxesState ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseApproximateTaxesMunicipal ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:nfseServiceIntermediary ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:hasFile ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Brazilian NFS-e" ;
    rdfs:comment "Brazilian electronic service invoice (Nota Fiscal de Serviço Eletrônica)" ;
    foundation:icon "description" ;
    rdfs:seeAlso """
NFS-e (Nota Fiscal de Serviço Eletrônica) is the Brazilian electronic service invoice system.

Key information:
- Access key (chave de acesso) - unique 44-digit identifier
- NFS-e number and competence date
- Emission date and time
- Service provider (prestador) and service taker (tomador)
- Service description and values
- Municipal taxation (ISSQN)
- Federal taxation (IRRF, PIS, COFINS, Social Security)
- Simples Nacional information
- DPS (Declaração de Prestação de Serviço) information

Example:
  :nfse4 a foundation:BrazilianNFSe ;
      foundation:nfseAccessKey "41069022264110609000104000000000000426023827549219" ;
      foundation:nfseNumber "4" ;
      foundation:nfseCompetenceDate "2026-02-13"^^xsd:date ;
      foundation:nfseEmissionDateTime "2026-02-13T10:34:43"^^xsd:dateTime ;
      foundation:nfseIssuerMunicipality :curitiba ;
      foundation:nfseServiceProvider :terraTech ;
      foundation:nfseServiceTaker :ingresse ;
      foundation:nfseServiceLocation :curitiba ;
      foundation:nfseISSQNMunicipality :curitiba ;
      foundation:nfseServiceValue "19140.85"^^xsd:decimal ;
      foundation:nfseNetValue "19140.85"^^xsd:decimal ;
      foundation:invoiceCurrency currency:BRL ;
      foundation:nfseSimplesNacionalOptant true ;
      foundation:hasFile :nfse4_pdf .

Cardinality constraints:
- nfseAccessKey: exactly 1 (required)
- nfseNumber: exactly 1 (required)
- nfseCompetenceDate: exactly 1 (required)
- nfseEmissionDateTime: exactly 1 (required)
- nfseIssuerMunicipality: exactly 1 (required)
- nfseServiceProvider: exactly 1 (required)
- nfseServiceTaker: exactly 1 (required)
- nfseServiceDescription: exactly 1 (required)
- nfseServiceValue: exactly 1 (required)
- nfseNetValue: exactly 1 (required)
- hasFile: max 1 (optional - PDF attachment)
- All other properties: max 1 (optional)
""" .

# -----------------------------------------------------------------------------
# Core Identification Properties
# -----------------------------------------------------------------------------

foundation:nfseAccessKey a owl:DatatypeProperty ;
    rdfs:label "NFS-e access key" ;
    rdfs:comment "44-digit unique identifier (chave de acesso) for the NFS-e" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseAccessKey "41069022264110609000104000000000000426023827549219" .
""" .

foundation:nfseNumber a owl:DatatypeProperty ;
    rdfs:label "NFS-e number" ;
    rdfs:comment "Sequential number of the NFS-e" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseNumber "4" .
""" .

foundation:nfseCompetenceDate a owl:DatatypeProperty ;
    rdfs:label "NFS-e competence date" ;
    rdfs:comment "Date of competence for the service (competência)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:date ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseCompetenceDate "2026-02-13"^^xsd:date .
""" .

foundation:nfseEmissionDateTime a owl:DatatypeProperty ;
    rdfs:label "NFS-e emission date and time" ;
    rdfs:comment "Date and time when the NFS-e was issued" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseEmissionDateTime "2026-02-13T10:34:43"^^xsd:dateTime .
""" .

foundation:nfseIssuerMunicipality a owl:ObjectProperty ;
    rdfs:label "NFS-e issuer municipality" ;
    rdfs:comment "Municipality where the NFS-e was issued" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range foundation:City ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseIssuerMunicipality :curitiba .
""" .

# -----------------------------------------------------------------------------
# DPS Properties (Declaração de Prestação de Serviço)
# -----------------------------------------------------------------------------

foundation:dpsNumber a owl:DatatypeProperty ;
    rdfs:label "DPS number" ;
    rdfs:comment "Number of the DPS (Declaração de Prestação de Serviço)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:dpsNumber "1" .
""" .

foundation:dpsSeries a owl:DatatypeProperty ;
    rdfs:label "DPS series" ;
    rdfs:comment "Series of the DPS" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:dpsSeries "70000" .
""" .

foundation:dpsEmissionDateTime a owl:DatatypeProperty ;
    rdfs:label "DPS emission date and time" ;
    rdfs:comment "Date and time when the DPS was issued" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:dpsEmissionDateTime "2026-02-13T10:34:43"^^xsd:dateTime .
""" .

# -----------------------------------------------------------------------------
# Party Properties
# -----------------------------------------------------------------------------

foundation:nfseServiceProvider a owl:ObjectProperty ;
    rdfs:label "NFS-e service provider" ;
    rdfs:comment "The company providing the service (prestador)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range foundation:Company ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseServiceProvider :terraTech .
""" .

foundation:nfseServiceTaker a owl:ObjectProperty ;
    rdfs:label "NFS-e service taker" ;
    rdfs:comment "The company or person receiving the service (tomador)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseServiceTaker :ingresse .
""" .

foundation:nfseServiceIntermediary a owl:ObjectProperty ;
    rdfs:label "NFS-e service intermediary" ;
    rdfs:comment "Optional intermediary in the service (intermediário)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseServiceIntermediary :platformCompany .
""" .

# -----------------------------------------------------------------------------
# Service Properties
# -----------------------------------------------------------------------------

foundation:nfseServiceDescription a owl:DatatypeProperty ;
    rdfs:label "NFS-e service description" ;
    rdfs:comment "Description of the service provided" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseServiceDescription "Prestação de serviço realizada em Fevereiro/26" .
""" .

foundation:nfseTaxationCode a owl:DatatypeProperty ;
    rdfs:label "NFS-e taxation code" ;
    rdfs:comment "National taxation code (Código de Tributação Nacional)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseTaxationCode "01.05.01" .
""" .

foundation:nfseMunicipalTaxationCode a owl:DatatypeProperty ;
    rdfs:label "NFS-e municipal taxation code" ;
    rdfs:comment "Municipal taxation code (Código de Tributação Municipal)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseMunicipalTaxationCode "10203" .
""" .

foundation:nfseServiceLocation a owl:ObjectProperty ;
    rdfs:label "NFS-e service location" ;
    rdfs:comment "Location where the service was provided" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range foundation:City ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseServiceLocation :curitiba .
""" .

# -----------------------------------------------------------------------------
# Value Properties
# -----------------------------------------------------------------------------

foundation:nfseServiceValue a owl:DatatypeProperty ;
    rdfs:label "NFS-e service value" ;
    rdfs:comment "Total value of the service (Valor do Serviço)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseServiceValue "19140.85"^^xsd:decimal .
""" .

foundation:nfseNetValue a owl:DatatypeProperty ;
    rdfs:label "NFS-e net value" ;
    rdfs:comment "Net value after deductions and retentions (Valor Líquido)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseNetValue "19140.85"^^xsd:decimal .
""" .

foundation:nfseConditionalDiscount a owl:DatatypeProperty ;
    rdfs:label "NFS-e conditional discount" ;
    rdfs:comment "Conditional discount (Desconto Condicionado)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseConditionalDiscount "100.00"^^xsd:decimal .
""" .

foundation:nfseUnconditionalDiscount a owl:DatatypeProperty ;
    rdfs:label "NFS-e unconditional discount" ;
    rdfs:comment "Unconditional discount (Desconto Incondicionado)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseUnconditionalDiscount "50.00"^^xsd:decimal .
""" .

foundation:nfseDeductions a owl:DatatypeProperty ;
    rdfs:label "NFS-e deductions" ;
    rdfs:comment "Total deductions/reductions (Total Deduções/Reduções)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseDeductions "200.00"^^xsd:decimal .
""" .

# -----------------------------------------------------------------------------
# Municipal Taxation (ISSQN) Properties
# -----------------------------------------------------------------------------

foundation:nfseISSQNTaxation a owl:DatatypeProperty ;
    rdfs:label "NFS-e ISSQN taxation" ;
    rdfs:comment "ISSQN taxation status (e.g., Operação Tributável)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseISSQNTaxation "Operação Tributável" .
""" .

foundation:nfseISSQNMunicipality a owl:ObjectProperty ;
    rdfs:label "NFS-e ISSQN municipality" ;
    rdfs:comment "Municipality where ISSQN is due (Município de Incidência do ISSQN)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range foundation:City ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseISSQNMunicipality :curitiba .
""" .

foundation:nfseISSQNBaseCalculation a owl:DatatypeProperty ;
    rdfs:label "NFS-e ISSQN base calculation" ;
    rdfs:comment "Base value for ISSQN calculation (BC ISSQN)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseISSQNBaseCalculation "19140.85"^^xsd:decimal .
""" .

foundation:nfseISSQNRate a owl:DatatypeProperty ;
    rdfs:label "NFS-e ISSQN rate" ;
    rdfs:comment "ISSQN tax rate applied (Alíquota Aplicada)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseISSQNRate "5.00"^^xsd:decimal .
""" .

foundation:nfseISSQNValue a owl:DatatypeProperty ;
    rdfs:label "NFS-e ISSQN value" ;
    rdfs:comment "ISSQN tax amount (ISSQN Apurado)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseISSQNValue "957.04"^^xsd:decimal .
""" .

foundation:nfseISSQNRetention a owl:DatatypeProperty ;
    rdfs:label "NFS-e ISSQN retention" ;
    rdfs:comment "Whether ISSQN was retained (Retenção do ISSQN)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Common values:
- "Não Retido" (not retained)
- "Retido" (retained)

Example:
  :nfse4 foundation:nfseISSQNRetention "Não Retido" .
""" .

# -----------------------------------------------------------------------------
# Federal Taxation Properties
# -----------------------------------------------------------------------------

foundation:nfseIRRF a owl:DatatypeProperty ;
    rdfs:label "NFS-e IRRF" ;
    rdfs:comment "Income tax withholding at source (Imposto de Renda Retido na Fonte)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseIRRF "1500.00"^^xsd:decimal .
""" .

foundation:nfseSocialSecurityContribution a owl:DatatypeProperty ;
    rdfs:label "NFS-e social security contribution" ;
    rdfs:comment "Social security contribution withheld (Contribuição Previdenciária - Retida)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseSocialSecurityContribution "200.00"^^xsd:decimal .
""" .

foundation:nfseSocialContributions a owl:DatatypeProperty ;
    rdfs:label "NFS-e social contributions" ;
    rdfs:comment "Other social contributions withheld (Contribuições Sociais - Retidas)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseSocialContributions "100.00"^^xsd:decimal .
""" .

foundation:nfsePIS a owl:DatatypeProperty ;
    rdfs:label "NFS-e PIS" ;
    rdfs:comment "PIS contribution (PIS - Débito Apuração Própria)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfsePIS "123.00"^^xsd:decimal .
""" .

foundation:nfseCOFINS a owl:DatatypeProperty ;
    rdfs:label "NFS-e COFINS" ;
    rdfs:comment "COFINS contribution (COFINS - Débito Apuração Própria)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseCOFINS "567.00"^^xsd:decimal .
""" .

foundation:nfseTotalFederalRetentions a owl:DatatypeProperty ;
    rdfs:label "NFS-e total federal retentions" ;
    rdfs:comment "Total federal tax retentions (Total das Retenções Federais)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseTotalFederalRetentions "1800.00"^^xsd:decimal .
""" .

# -----------------------------------------------------------------------------
# Tax Regime Properties
# -----------------------------------------------------------------------------

foundation:nfseSimplesNacionalOptant a owl:DatatypeProperty ;
    rdfs:label "NFS-e Simples Nacional optant" ;
    rdfs:comment "Whether the service provider is a Simples Nacional optant (ME/EPP)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseSimplesNacionalOptant true .
""" .

foundation:nfseTaxRegime a owl:DatatypeProperty ;
    rdfs:label "NFS-e tax regime" ;
    rdfs:comment "Tax regime for the service provider" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse4 foundation:nfseTaxRegime "Regime de apuração dos tributos federais e municipal pelo Simples Nacional" .
""" .

foundation:nfseSpecialTaxRegime a owl:DatatypeProperty ;
    rdfs:label "NFS-e special tax regime" ;
    rdfs:comment "Special tax regime, if applicable (Regime Especial de Tributação)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseSpecialTaxRegime "Microempreendedor Individual (MEI)" .
""" .

# -----------------------------------------------------------------------------
# Approximate Taxes (Lei 12.741/2012)
# -----------------------------------------------------------------------------

foundation:nfseApproximateTaxesFederal a owl:DatatypeProperty ;
    rdfs:label "NFS-e approximate federal taxes" ;
    rdfs:comment "Approximate federal taxes according to Lei 12.741/2012" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseApproximateTaxesFederal "1000.00"^^xsd:decimal .
""" .

foundation:nfseApproximateTaxesState a owl:DatatypeProperty ;
    rdfs:label "NFS-e approximate state taxes" ;
    rdfs:comment "Approximate state taxes according to Lei 12.741/2012" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseApproximateTaxesState "500.00"^^xsd:decimal .
""" .

foundation:nfseApproximateTaxesMunicipal a owl:DatatypeProperty ;
    rdfs:label "NFS-e approximate municipal taxes" ;
    rdfs:comment "Approximate municipal taxes according to Lei 12.741/2012" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :nfse123 foundation:nfseApproximateTaxesMunicipal "300.00"^^xsd:decimal .
""" .

# -----------------------------------------------------------------------------
# Additional Information
# -----------------------------------------------------------------------------

foundation:nfseComplementaryInfo a owl:DatatypeProperty ;
    rdfs:label "NFS-e complementary information" ;
    rdfs:comment "Additional complementary information (Informações Complementares)" ;
    rdfs:domain foundation:BrazilianNFSe ;
    rdfs:range xsd:string ;
