@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Neighborhood
# =============================================================================
# Neighborhood or district within a city
#
# Version: 0.1.0
# License: MIT
# =============================================================================

foundation:Neighborhood a owl:Class ;
    rdfs:subClassOf foundation:GeographicLocation ;
    rdfs:label "Neighborhood" ;
    rdfs:comment "A neighborhood or district within a city" ;
    foundation:icon "home_work" ;
    rdfs:seeAlso """
Examples:
- Cambuí (Campinas, SP)
- SoHo (New York, NY)
- Shibuya (Tokyo, JP)
""" .

# -----------------------------------------------------------------------------
# Neighborhood Properties
# -----------------------------------------------------------------------------

foundation:neighborhoodName a owl:DatatypeProperty ;
    rdfs:label "neighborhood name" ;
    rdfs:comment "Name of the neighborhood or district" ;
    rdfs:domain foundation:Neighborhood ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :cambui foundation:neighborhoodName "Cambuí" .
""" .
