@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# ToolUse - Represents a tool/function call made by an AI assistant
# =============================================================================
# A ToolUse captures when an AI assistant invokes a tool/function during
# a conversation, including the tool name, input parameters, and unique ID.
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:ToolUse a owl:Class ;
    rdfs:subClassOf foundation:InformationObject ,
        [ a owl:Restriction ;
          owl:onProperty foundation:toolName ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:toolUseId ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:toolInput ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:partOfMessage ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Tool Use" ;
    rdfs:comment "Represents a tool/function call made by an AI assistant during a conversation" ;
    foundation:icon "construction" ;
    rdfs:seeAlso """
Examples:
- AI calls search_classes with query parameter
- AI calls get_instance with IRI parameter
- AI calls create_class with label and icon

Cardinality constraints:
- toolName: exactly 1 (required, name of the tool/function)
- toolUseId: exactly 1 (required, unique ID from API response)
- toolInput: exactly 1 (required, JSON input parameters)
- partOfMessage: exactly 1 (required, which message contains this tool use)
""" .

# =============================================================================
# ToolResult - Represents the result of executing a tool/function
# =============================================================================
# A ToolResult captures the output from executing a tool, whether successful
# or failed, and links back to the ToolUse that triggered it.
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:ToolResult a owl:Class ;
    rdfs:subClassOf foundation:InformationObject ,
        [ a owl:Restriction ;
          owl:onProperty foundation:resultOf ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:resultContent ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:partOfMessage ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Tool Result" ;
    rdfs:comment "Represents the result of executing a tool/function call" ;
    foundation:icon "check_circle" ;
    rdfs:seeAlso """
Examples:
- Result from search_classes returning list of classes
- Result from get_instance returning instance details
- Error result from failed tool execution

Cardinality constraints:
- resultOf: exactly 1 (required, which ToolUse this is the result of)
- resultContent: exactly 1 (required, JSON result content)
- partOfMessage: exactly 1 (required, which message contains this result)
""" .

# -----------------------------------------------------------------------------
# ToolUse Properties
# -----------------------------------------------------------------------------

foundation:toolName a owl:DatatypeProperty ;
    rdfs:label "tool name" ;
    rdfs:comment "The name of the tool/function being called (e.g., 'search_classes', 'get_instance')" ;
    rdfs:domain foundation:ToolUse ;
    rdfs:range xsd:string .

foundation:toolUseId a owl:DatatypeProperty ;
    rdfs:label "tool use ID" ;
    rdfs:comment "Unique identifier for this tool use from the API response (e.g., 'toolu_01A2B3C4D5')" ;
    rdfs:domain foundation:ToolUse ;
    rdfs:range xsd:string .

foundation:toolInput a owl:DatatypeProperty ;
    rdfs:label "tool input" ;
    rdfs:comment "JSON string containing the input parameters for the tool call" ;
    rdfs:domain foundation:ToolUse ;
    rdfs:range xsd:string .

foundation:executionOrder a owl:DatatypeProperty ;
    rdfs:label "execution order" ;
    rdfs:comment "Sequence number indicating the order of tool execution within a message (0-indexed)" ;
    rdfs:domain foundation:ToolUse ;
    rdfs:range xsd:integer .

# -----------------------------------------------------------------------------
# ToolResult Properties
# -----------------------------------------------------------------------------

foundation:resultOf a owl:ObjectProperty ;
    rdfs:label "result of" ;
    rdfs:comment "Links a ToolResult to the ToolUse that it is the result of" ;
    rdfs:domain foundation:ToolResult ;
    rdfs:range foundation:ToolUse .

foundation:resultContent a owl:DatatypeProperty ;
    rdfs:label "result content" ;
    rdfs:comment "JSON string containing the result data from executing the tool" ;
    rdfs:domain foundation:ToolResult ;
    rdfs:range xsd:string .

foundation:isSuccess a owl:DatatypeProperty ;
    rdfs:label "is success" ;
    rdfs:comment "Whether the tool execution was successful (true) or failed (false)" ;
    rdfs:domain foundation:ToolResult ;
    rdfs:range xsd:boolean .

foundation:errorMessage a owl:DatatypeProperty ;
    rdfs:label "error message" ;
    rdfs:comment "Error message if the tool execution failed (null if successful)" ;
    rdfs:domain foundation:ToolResult ;
    rdfs:range xsd:string .

# -----------------------------------------------------------------------------
# Shared Properties (for both ToolUse and ToolResult)
# -----------------------------------------------------------------------------

foundation:partOfMessage a owl:ObjectProperty ;
    rdfs:label "part of message" ;
    rdfs:comment "Links a ToolUse or ToolResult to the Message it belongs to" ;
    rdfs:range foundation:Message .
