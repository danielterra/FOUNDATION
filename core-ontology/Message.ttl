@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Message & Communication Medium
# =============================================================================
# A discrete unit of communication between agents, transmitted through a medium
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:Message a owl:Class ;
    rdfs:subClassOf foundation:InformationObject ,
        [ a owl:Restriction ;
          owl:onProperty foundation:sender ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:sentAt ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Message" ;
    rdfs:comment "A discrete unit of communication from one sender to one or more receivers, transmitted through a medium. Can contain text, audio, video, images, or files." ;
    foundation:icon "chat_bubble" ;
    rdfs:seeAlso """
Examples:
- Text: User asks AI "What is 2+2?"
- Audio: Voice message in WhatsApp
- Video: Video message sent via chat
- Image: Photo shared in conversation
- File: PDF document attached to email
- Mixed: Email with text + attachments

Cardinality constraints:
- sender: exactly 1 (who sent it)
- receiver: 0-N (can have multiple receivers)
- sentAt: exactly 1 (timestamp)
- content: 0-1 (text content, optional)
- hasAttachment: 0-N (audio, video, images, files)
- transmittedVia: 0-1 (optional medium/channel)
- partOfConversation: 0-1 (optional conversation grouping)
- messageType: 0-1 (text, audio, video, image, file, mixed)

Note: At least one of 'content' or 'hasAttachment' should be present.
""" .

# Note: CommunicationMedium class is defined in CommunicationMedium.ttl

# -----------------------------------------------------------------------------
# Message Properties
# -----------------------------------------------------------------------------

foundation:content a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "content" ;
    rdfs:comment "The actual text content of the message" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:content "What is 2+2?" .
  :msg2 foundation:content "The answer is 4" .
""" .

foundation:sender a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sender" ;
    rdfs:comment "The agent who sent this message (exactly one sender)" ;
    rdfs:domain foundation:Message ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:sender foundation:ThisUser .
  :msg2 foundation:sender foundation:LocalAIAssistant .

Note: AgentCapacity covers both Person and SoftwareAgent.
""" .

foundation:receiver a owl:ObjectProperty ;
    rdfs:label "receiver" ;
    rdfs:comment "An agent who receives this message (can have multiple receivers)" ;
    rdfs:domain foundation:Message ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Example:
  # One-to-one message:
  :msg1 foundation:receiver foundation:LocalAIAssistant .

  # One-to-many message (broadcast):
  :msg2 foundation:receiver :alice .
  :msg2 foundation:receiver :bob .
  :msg2 foundation:receiver :charlie .

  # Group message (transmittedVia captures the group):
  :msg3 foundation:transmittedVia :whatsappFamilyGroup .
  :msg3 foundation:receiver :mom .
  :msg3 foundation:receiver :dad .
""" .

foundation:transmittedVia a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "transmitted via" ;
    rdfs:comment "The medium/channel through which this message was transmitted" ;
    rdfs:domain foundation:Message ;
    rdfs:range foundation:CommunicationMedium ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:transmittedVia :foundationChatInterface .
  :msg2 foundation:transmittedVia :whatsappFamilyGroup .
  :msg3 foundation:transmittedVia :gmailService .
  :msg4 foundation:transmittedVia :postalService .

Where:
  :foundationChatInterface rdf:type foundation:Application .
  :whatsappFamilyGroup rdf:type foundation:CommunicationMedium .
  :gmailService rdf:type foundation:Service .
  :postalService rdf:type foundation:Service .
""" .

foundation:sentAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "sent at" ;
    rdfs:comment "Timestamp when the message was sent (ISO 8601 format)" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:sentAt "2025-12-27T14:23:45Z"^^xsd:dateTime .
""" .

foundation:receivedAt a owl:DatatypeProperty ;
    rdfs:label "received at" ;
    rdfs:comment "Timestamp when the message was received (can differ from sentAt for async)" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:sentAt "2025-12-27T14:23:45Z"^^xsd:dateTime .
  :msg1 foundation:receivedAt "2025-12-27T14:23:47Z"^^xsd:dateTime .
""" .

foundation:partOfConversation a owl:ObjectProperty ;
    rdfs:label "part of conversation" ;
    rdfs:comment "Links a message to the conversation it belongs to" ;
    rdfs:domain foundation:Message ;
    rdfs:range foundation:Conversation ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:partOfConversation :conv1 .
  :msg2 foundation:partOfConversation :conv1 .
""" .

foundation:hasAttachment a owl:ObjectProperty ;
    rdfs:label "has attachment"@en ;
    rdfs:label "tem anexo"@pt ;
    rdfs:comment "Links to an Attachment (which wraps a File) attached to this message (can have multiple attachments)" ;
    rdfs:domain foundation:Message ;
    rdfs:range foundation:Attachment ;
    rdfs:seeAlso """
Examples:
  # Text with single image attachment:
  :msg1 foundation:content "Check out this photo!" ;
        foundation:hasAttachment :attach1 .

  :attach1 a foundation:Attachment ;
      foundation:attachesFile :photoFile ;
      foundation:attachedAt "2024-02-28T10:00:00Z"^^xsd:dateTime .

  :photoFile a foundation:File ;
      foundation:fileName "screenshot.png" ;
      foundation:hasFileType foundation:FileType_PNG ;
      foundation:fileSize 524288 .

  # Email with multiple file attachments:
  :msg2 foundation:content "See attached files" ;
        foundation:hasAttachment :attach2 ;
        foundation:hasAttachment :attach3 .

  :attach2 foundation:attachesFile :contractPDF .
  :attach3 foundation:attachesFile :spreadsheet .

  # PDF with Claude Files API:
  :msg3 foundation:hasAttachment :attach4 .

  :attach4 a foundation:Attachment ;
      foundation:attachesFile :myPDF ;
      foundation:claudeFileId "file-abc123xyz" ;
      foundation:base64Data "JVBERi0xLjQ..." .

Note: Attachment is a wrapper that:
- Links a File (generic file metadata) to a Message
- Adds AI-specific data (base64 for Vision API, claudeFileId for Files API)
- Tracks when the file was attached (attachedAt timestamp)
""" .

foundation:messageType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "message type" ;
    rdfs:comment "Type classification of the message content" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :msg1 foundation:messageType "text" .       # Text only
  :msg2 foundation:messageType "audio" .      # Audio only
  :msg3 foundation:messageType "video" .      # Video only
  :msg4 foundation:messageType "image" .      # Image only
  :msg5 foundation:messageType "file" .       # File only
  :msg6 foundation:messageType "mixed" .      # Text + attachments (like email)

Suggested values: text, audio, video, image, file, mixed
""" .

# -----------------------------------------------------------------------------
# AI Usage Tracking Properties (for AI-generated messages)
# -----------------------------------------------------------------------------

foundation:tokenCount a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "token count" ;
    rdfs:comment "Total number of tokens in this message content (calculated once at creation using Claude tokenizer)" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:tokenCount 142 .

This is the token count of the message itself (content + attachments + tool_use/tool_result blocks).
Calculated once when the message is created to optimize history loading performance.
Uses the same tokenizer (cl100k_base) that Claude API uses.
""" .

foundation:inputTokens a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "input tokens" ;
    rdfs:comment "Number of input tokens consumed by AI to generate this message" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:inputTokens 1250 .

Used for tracking AI API usage and costs. Only applicable to AI-generated messages.
""" .

foundation:outputTokens a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "output tokens" ;
    rdfs:comment "Number of output tokens generated by AI in this message" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:outputTokens 450 .

Used for tracking AI API usage and costs. Only applicable to AI-generated messages.
""" .

foundation:cacheCreationInputTokens a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cache creation input tokens" ;
    rdfs:comment "Number of input tokens used to create prompt cache (charged at higher rate)" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:cacheCreationInputTokens 5000 .

Claude API feature: First time context is cached, charged at 1.25x base rate.
""" .

foundation:cacheReadInputTokens a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cache read input tokens" ;
    rdfs:comment "Number of input tokens read from prompt cache (charged at lower rate)" ;
    rdfs:domain foundation:Message ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso """
Example:
  :msg1 foundation:cacheReadInputTokens 5000 .

Claude API feature: Cached context reuse, charged at 0.1x base rate (90% savings).
""" .

