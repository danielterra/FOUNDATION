@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# RG (Registro Geral)
# =============================================================================
# Brazilian national identity card
#
# Version: 0.1.0
# License: MIT
# =============================================================================

foundation:RG a owl:Class ;
    rdfs:subClassOf foundation:IdentificationDocument ;
    rdfs:label "RG" ;
    rdfs:comment "Registro Geral - Brazilian national identity card" ;
    foundation:icon "badge" ;
    rdfs:seeAlso """
The RG (Registro Geral) is the primary identification document in Brazil,
issued by state governments (SSP).

Example:
  :johnRG a foundation:RG ;
      foundation:documentNumber "12.345.678-9" ;
      foundation:issuingAuthority "SSP-SP" ;
      foundation:issueDate "2010-05-15"^^xsd:date .
""" .
