@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# Financial Institution
# =============================================================================
# Banking and financial services organizations
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

<http://foundation.local/ontology/FinancialInstitution>
  a owl:Ontology ;
  rdfs:label "FOUNDATION Financial Institution Ontology" ;
  rdfs:comment "Banking and financial services organizations" ;
.

# -----------------------------------------------------------------------------
# Financial Institution
# -----------------------------------------------------------------------------

foundation:FinancialInstitution a owl:Class ;
    rdfs:subClassOf foundation:Organization ,
        [ a owl:Restriction ;
          owl:onProperty foundation:bankName ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:bankCode ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Financial Institution" ;
    rdfs:comment "A bank or financial services organization" ;
    foundation:icon "account_balance" ;
    rdfs:seeAlso """
Represents a bank, credit union, or other financial institution.

Examples:
- Bank of America
- Chase
- Wells Fargo
- Itaú (Brazil)
- Banco do Brasil
- Credit unions

Cardinality constraints:
- bankName: exactly 1 (required)
- bankCode: max 1 (optional)
""" .

foundation:bankCode a owl:DatatypeProperty ;
    rdfs:label "bank code" ;
    rdfs:comment "Official code identifying the bank (e.g., 3-digit code in Brazil)" ;
    rdfs:domain foundation:FinancialInstitution ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example (Brazil):
  :itau foundation:bankCode "341" .
  :bancoDoBrasil foundation:bankCode "001" .
""" .

foundation:bankName a owl:DatatypeProperty ;
    rdfs:label "bank name" ;
    rdfs:comment "Official name of the financial institution" ;
    rdfs:domain foundation:FinancialInstitution ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :itau foundation:bankName "Itaú Unibanco S.A." .
""" .

# Note: foundation:cnpj is defined in Company.ttl and can also be used with FinancialInstitution
# since FinancialInstitution is a subclass of Organization (and banks in Brazil have CNPJs).
# Example:
#   :itau foundation:cnpj "60.701.190/0001-04" .
