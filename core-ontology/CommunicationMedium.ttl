@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# CommunicationMedium
# =============================================================================
# The channel, platform, or means through which messages are transmitted
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:CommunicationMedium a owl:Class ;
    rdfs:subClassOf foundation:Thing ;
    rdfs:label "Communication Medium" ;
    rdfs:comment "The channel, platform, or means through which a message is transmitted. Can be a software application, telecom service, physical delivery, or group/channel within a platform." ;
    foundation:icon "sensors" ;
    rdfs:seeAlso """
Examples by Type:

Software Applications (providedBy → Application/Service):
- FOUNDATION Chat Interface (internal app)
- WhatsApp (messaging app, can have groups)
- Gmail (email service)
- Slack (team communication, has channels)
- Telegram (messaging app, has channels and groups)
- Microsoft Teams (collaboration platform)

Telecommunication Services (providedBy → TelecommunicationProvider):
- SMS via Vivo (text messaging through carrier)
- Voice Call via Claro (phone call through carrier)
- SMS via AT&T (international SMS)
- Voice Call via T-Mobile (voice service)

Physical Delivery:
- Postal service (letters, packages)
- Courier service (DHL, FedEx)
- Hand delivery (in-person)

Groups/Channels (providedBy → parent application):
- WhatsApp Group "Family" (group within WhatsApp)
- Slack channel #general (channel within Slack workspace)
- Telegram channel "News" (broadcast channel)

Subtypes (suggested):
- DigitalCommunicationMedium: chat apps, email, forums
- PhysicalCommunicationMedium: postal mail, courier
- TelecommunicationMedium: SMS, voice calls via carriers
- BroadcastMedium: TV, radio, public channels

Use Cases:
- Track which platform/service a message was sent through
- Model groups/channels as mediums within applications
- Distinguish between SMS via Vivo vs. WhatsApp message
- Link messages to telecommunication providers (for billing, analytics)
- Separate application-level mediums from network-level carriers
""" .

# -----------------------------------------------------------------------------
# CommunicationMedium Properties
# -----------------------------------------------------------------------------

foundation:mediumName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "medium name" ;
    rdfs:comment "The name/identifier of the communication medium" ;
    rdfs:domain foundation:CommunicationMedium ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :foundationChat foundation:mediumName "FOUNDATION Chat Interface" .
  :whatsappFamily foundation:mediumName "Family Group" .
  :slackGeneral foundation:mediumName "#general" .
  :gmailService foundation:mediumName "Gmail" .
""" .

foundation:mediumType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "medium type" ;
    rdfs:comment "Type classification of the medium (chat, email, sms, voice, video, physical)" ;
    rdfs:domain foundation:CommunicationMedium ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:

Digital messaging:
  :foundationChat foundation:mediumType "chat" .
  :whatsappGroup foundation:mediumType "chat" .
  :gmailService foundation:mediumType "email" .

Telecommunication (via carriers):
  :smsViaVivo foundation:mediumType "sms" .
  :smsViaClaro foundation:mediumType "sms" .
  :voiceCallVivo foundation:mediumType "voice" .
  :voiceCallTMobile foundation:mediumType "voice" .

Video communication:
  :zoomCall foundation:mediumType "video" .
  :teamsVideoCall foundation:mediumType "video" .
  :whatsappVideoCall foundation:mediumType "video" .

Physical:
  :postalService foundation:mediumType "physical" .
  :courierDelivery foundation:mediumType "physical" .

Broadcast:
  :telegramChannel foundation:mediumType "broadcast" .
  :youtubeChannel foundation:mediumType "broadcast" .

Suggested values: chat, email, sms, voice, video, physical, broadcast
""" .

foundation:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "An agent who is a member/participant of this communication medium. Use this to model group/channel membership. If a medium has no members defined, it's considered a direct/1-to-1 medium." ;
    rdfs:domain foundation:CommunicationMedium ;
    rdfs:range foundation:AgentCapacity ;
    rdfs:seeAlso """
Examples:

WhatsApp Group "Família" (group medium with members):
  :whatsappFamily rdf:type foundation:CommunicationMedium .
  :whatsappFamily foundation:mediumName "Família" .
  :whatsappFamily foundation:mediumType "chat" .
  :whatsappFamily foundation:hasMember :mom .
  :whatsappFamily foundation:hasMember :dad .
  :whatsappFamily foundation:hasMember :sister .
  :whatsappFamily foundation:hasMember foundation:ThisUser .
  :whatsappFamily foundation:providedBy :whatsappApp .

Slack Channel #general (group medium with members):
  :slackGeneral rdf:type foundation:CommunicationMedium .
  :slackGeneral foundation:mediumName "#general" .
  :slackGeneral foundation:mediumType "chat" .
  :slackGeneral foundation:hasMember :alice .
  :slackGeneral foundation:hasMember :bob .
  :slackGeneral foundation:hasMember :charlie .
  :slackGeneral foundation:providedBy :slackWorkspace .

FOUNDATION Direct Chat (no members = direct/1-to-1):
  :foundationChat rdf:type foundation:CommunicationMedium .
  :foundationChat foundation:mediumName "FOUNDATION Chat" .
  :foundationChat foundation:mediumType "chat" .
  :foundationChat foundation:providedBy foundation:ThisFoundationInstance .
  # No hasMember = direct chat between sender and receiver in messages

Note: To check if a medium is a group:
  - Has members (hasMember property exists) = Group/Channel
  - No members defined = Direct/1-to-1 communication
""" .

foundation:providedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "provided by" ;
    rdfs:comment "The service, application, or provider that provides this communication medium" ;
    rdfs:domain foundation:CommunicationMedium ;
    rdfs:range foundation:Thing ;
    rdfs:seeAlso """
Examples:

Software applications:
  :foundationChat foundation:providedBy foundation:ThisFoundationInstance .
  :whatsappFamily foundation:providedBy :whatsappApp .
  :slackGeneral foundation:providedBy :slackWorkspace .
  :gmailInbox foundation:providedBy :gmailService .

Telecommunication carriers (SMS, voice):
  :smsViaVivo foundation:providedBy :vivoCarrier .
  :voiceCallVivo foundation:providedBy :vivoCarrier .
  :smsTMobile foundation:providedBy :tmobileCarrier .
  :voiceCallClaro foundation:providedBy :claroCarrier .

Physical delivery:
  :postalMail foundation:providedBy :nationalPostalService .
  :courierDelivery foundation:providedBy :dhlService .

Where:
  foundation:ThisFoundationInstance rdf:type foundation:Application .
  :whatsappApp rdf:type foundation:Application .
  :slackWorkspace rdf:type foundation:Service .
  :gmailService rdf:type foundation:Service .
  :vivoCarrier rdf:type foundation:Organization .  # Telecommunication provider
  :claroCarrier rdf:type foundation:Organization .
  :tmobileCarrier rdf:type foundation:Organization .
  :nationalPostalService rdf:type foundation:Service .
  :dhlService rdf:type foundation:Service .
""" .
