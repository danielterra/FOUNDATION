@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix currency: <http://qudt.org/vocab/currency/> .

# =============================================================================
# ServiceContract
# =============================================================================
# A contract specifically for the provision of services
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

<http://foundation.local/ontology/ServiceContract>
  a owl:Ontology ;
  rdfs:label "FOUNDATION Service Contract Ontology" ;
  rdfs:comment "Service contract and milestone concepts" ;
  owl:imports <http://foundation.local/ontology/Contract> ;
.

foundation:ServiceContract a owl:Class ;
    rdfs:subClassOf foundation:Contract ;
    rdfs:label "Service Contract" ;
    rdfs:comment "A contract that specifies the provision of services by a contractor to a client" ;
    foundation:icon "handshake" ;
    rdfs:seeAlso """
A service contract defines the terms under which services are provided.

Examples:
- Software development contract
- Consulting services agreement
- Maintenance and support contract
- Cleaning services contract
- IT support contract
- Professional services agreement

Key characteristics:
- Defines scope of services
- May include deliverables and milestones
- Often includes payment terms and schedule
- May specify service level agreements (SLAs)
""" .

# -----------------------------------------------------------------------------
# ServiceContract Properties
# -----------------------------------------------------------------------------

foundation:serviceScope a owl:DatatypeProperty ;
    rdfs:label "service scope" ;
    rdfs:comment "Description of the services to be provided under this contract" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :devContract foundation:serviceScope "Development of a web application with React frontend and Node.js backend, including database design and API development" .
""" .

foundation:serviceDeliverables a owl:DatatypeProperty ;
    rdfs:label "service deliverables" ;
    rdfs:comment "Specific deliverables that must be provided under this contract" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :devContract foundation:serviceDeliverables "1. Functional web application; 2. Source code repository; 3. Technical documentation; 4. User manual" .
""" .

foundation:paymentSchedule a owl:DatatypeProperty ;
    rdfs:label "payment schedule" ;
    rdfs:comment "Schedule for payments under this contract" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :devContract foundation:paymentSchedule "30% upfront, 40% upon milestone completion, 30% upon final delivery" .
  :maintenanceContract foundation:paymentSchedule "Monthly payments on the 1st of each month" .
""" .

foundation:hourlyRate a owl:DatatypeProperty ;
    rdfs:label "hourly rate" ;
    rdfs:comment "Rate charged per hour of service (if applicable)" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :consultingContract foundation:hourlyRate "150.00"^^xsd:decimal ;
      foundation:contractCurrency currency:USD .
""" .

foundation:estimatedHours a owl:DatatypeProperty ;
    rdfs:label "estimated hours" ;
    rdfs:comment "Estimated number of hours required to complete the services" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso """
Example:
  :devContract foundation:estimatedHours "200"^^xsd:decimal .
""" .

foundation:serviceLevelAgreement a owl:DatatypeProperty ;
    rdfs:label "service level agreement" ;
    rdfs:comment "SLA terms specifying quality metrics and response times" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :supportContract foundation:serviceLevelAgreement "99.9% uptime, 4-hour response time for critical issues, 24-hour response for non-critical issues" .
""" .

foundation:workLocation a owl:DatatypeProperty ;
    rdfs:label "work location" ;
    rdfs:comment "Location where the services will be performed (on-site, remote, hybrid)" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :devContract foundation:workLocation "Remote" .
  :consultingContract foundation:workLocation "Client site in San Francisco" .
  :maintenanceContract foundation:workLocation "Hybrid (2 days on-site, 3 days remote)" .
""" .

foundation:invoicingFrequency a owl:DatatypeProperty ;
    rdfs:label "invoicing frequency" ;
    rdfs:comment "How often invoices are issued under this contract" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :devContract foundation:invoicingFrequency "Upon milestone completion" .
  :maintenanceContract foundation:invoicingFrequency "Monthly" .
  :consultingContract foundation:invoicingFrequency "Bi-weekly" .
""" .

foundation:paymentTermsDays a owl:DatatypeProperty ;
    rdfs:label "payment terms (days)" ;
    rdfs:comment "Number of days within which payment is due after invoicing" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso """
Example:
  :devContract foundation:paymentTermsDays "30"^^xsd:integer . # Net 30
  :urgentContract foundation:paymentTermsDays "15"^^xsd:integer . # Net 15
""" .

# -----------------------------------------------------------------------------
# ServiceContract - Milestone Relationship
# -----------------------------------------------------------------------------

foundation:hasMilestone a owl:ObjectProperty ;
    rdfs:label "has milestone" ;
    rdfs:comment "Links a service contract to its milestones" ;
    rdfs:domain foundation:ServiceContract ;
    rdfs:range foundation:Milestone ;
    rdfs:seeAlso """
Example:
  :devContract foundation:hasMilestone :milestone1 .
  :devContract foundation:hasMilestone :milestone2 .
""" .
