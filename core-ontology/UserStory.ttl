@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# UserStory
# =============================================================================
# A specific user need expressed from the user's perspective
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

<http://foundation.local/ontology/UserStory>
    a owl:Ontology ;
    owl:imports <http://foundation.local/ontology/Goal> ,
                <http://foundation.local/ontology/Persona> ,
                <http://foundation.local/ontology/SoftwareFeature> .

foundation:UserStory a owl:Class ;
    rdfs:subClassOf foundation:Goal ;
    rdfs:label "User Story" ;
    rdfs:comment "A specific user need expressed from the user's perspective, decomposed into Plans that describe how to implement it" ;
    foundation:icon "person_play" ;
    rdfs:seeAlso """
Standard format: As a [role], I want [capability], so that [benefit].

Examples:
- As a registered user, I want to log in with email and password, so that I can access my account
- As an admin, I want to export data as CSV, so that I can generate reports in Excel
- As a mobile user, I want the app to work offline, so that I can use it without internet

Relationship chain:
  UserStory
    ← Plan (contributesTo) — one per perspective: Backend, Frontend, UI/UX, Data, Ontology
      ← Task (contributesTo) — concrete work items, chained via dependsOn
""" .

# -----------------------------------------------------------------------------
# UserStory Properties
# -----------------------------------------------------------------------------

foundation:userRole a owl:ObjectProperty ;
    rdfs:label "user role" ;
    rdfs:comment "The persona this story is written for" ;
    rdfs:domain foundation:UserStory ;
    rdfs:range foundation:Persona .

foundation:capability a owl:DatatypeProperty ;
    rdfs:label "capability" ;
    rdfs:comment "What the user wants to do (the 'I want' part of the user story)" ;
    rdfs:domain foundation:UserStory ;
    rdfs:range xsd:string .

foundation:benefit a owl:DatatypeProperty ;
    rdfs:label "benefit" ;
    rdfs:comment "Why the user wants this capability — the value it delivers (the 'so that' part)" ;
    rdfs:domain foundation:UserStory ;
    rdfs:range xsd:string .

foundation:acceptanceCriteria a owl:DatatypeProperty ;
    rdfs:label "acceptance criteria" ;
    rdfs:comment "Conditions that must all be true for this story to be considered done" ;
    rdfs:domain foundation:UserStory ;
    rdfs:range xsd:string .

foundation:partOfFeature a owl:ObjectProperty ;
    rdfs:label "part of feature" ;
    rdfs:comment "The software feature this user story belongs to" ;
    rdfs:domain foundation:UserStory ;
    rdfs:range foundation:SoftwareFeature .
