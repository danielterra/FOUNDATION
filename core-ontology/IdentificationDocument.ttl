@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# IdentificationDocument
# =============================================================================
# Official identification documents (RG, CPF, CNH, Passport, etc.)
#
# Version: 0.1.0
# License: MIT
# =============================================================================

foundation:IdentificationDocument a owl:Class ;
    rdfs:subClassOf foundation:InformationObject ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty foundation:documentNumber ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty foundation:issueDate ;
        owl:minCardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty foundation:issuingAuthority ;
        owl:maxCardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty foundation:expirationDate ;
        owl:maxCardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty foundation:issuingCountry ;
        owl:maxCardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty foundation:issuingLocation ;
        owl:maxCardinality 1
    ] ;
    rdfs:label "Identification Document" ;
    rdfs:comment "An official document used to verify a person's identity" ;
    foundation:icon "badge" ;
    rdfs:seeAlso """
Examples:
- RG (Registro Geral - Brazil)
- CPF (Cadastro de Pessoa Física - Brazil)
- CNH (Driver's License - Brazil)
- Passport
- National ID Card
- Social Security Card

Cardinality Constraints:
- documentNumber: exactly 1 (required) - every identification document must have exactly one document number
- issueDate: min 1 (required) - every identification document must have at least one issue date
- issuingAuthority: max 1 - an identification document can have at most one issuing authority
- expirationDate: max 1 - an identification document can have at most one expiration date
- issuingCountry: max 1 - an identification document can have at most one issuing country
- issuingLocation: max 1 - an identification document can have at most one issuing location
""" .

# -----------------------------------------------------------------------------
# Document Properties
# -----------------------------------------------------------------------------

foundation:documentNumber a owl:DatatypeProperty ;
    rdfs:label "document number" ;
    rdfs:comment "The unique identification number of the document" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :myRG foundation:documentNumber "12.345.678-9" .
  :myCPF foundation:documentNumber "123.456.789-00" .
  :myPassport foundation:documentNumber "AB1234567" .
""" .

foundation:issuingAuthority a owl:DatatypeProperty ;
    rdfs:label "issuing authority" ;
    rdfs:comment "The government agency or organization that issued the document" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :myRG foundation:issuingAuthority "SSP-SP" .
  :myCNH foundation:issuingAuthority "DETRAN-RJ" .
  :myPassport foundation:issuingAuthority "Polícia Federal" .
""" .

foundation:issueDate a owl:DatatypeProperty ;
    rdfs:label "issue date" ;
    rdfs:comment "The date when the document was issued" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range xsd:date ;
    rdfs:seeAlso """
Example:
  :myPassport foundation:issueDate "2020-01-15"^^xsd:date .
""" .

foundation:expirationDate a owl:DatatypeProperty ;
    rdfs:label "expiration date" ;
    rdfs:comment "The date when the document expires (if applicable)" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range xsd:date ;
    rdfs:seeAlso """
Example:
  :myPassport foundation:expirationDate "2030-01-15"^^xsd:date .
  :myCNH foundation:expirationDate "2028-03-20"^^xsd:date .
""" .

foundation:issuingCountry a owl:ObjectProperty ;
    rdfs:label "issuing country" ;
    rdfs:comment "The country that issued the document" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range foundation:Country ;
    rdfs:seeAlso """
Example:
  :myPassport foundation:issuingCountry :brazil .
  :myID foundation:issuingCountry :portugal .
""" .

foundation:issuingLocation a owl:ObjectProperty ;
    rdfs:label "issuing location" ;
    rdfs:comment "The specific city where the document was issued" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range foundation:City ;
    rdfs:seeAlso """
Example:
  :myCNH foundation:issuingLocation :sorocaba .
  :myRG foundation:issuingLocation :saoPaulo .
""" .

foundation:observations a owl:DatatypeProperty ;
    rdfs:label "observations" ;
    rdfs:comment "Special observations, notes, or restrictions on the document (e.g., organ donor, medical restrictions)" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :myCNH foundation:observations "A" .  # Category A annotation
  :myRG foundation:observations "Doador de órgãos" .
""" .

foundation:documentPhoto a owl:DatatypeProperty ;
    rdfs:label "document photo" ;
    rdfs:comment "URI or base64-encoded photo associated with the document" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myPassport foundation:documentPhoto "file:///photos/passport_photo.jpg" .
  :myCNH foundation:documentPhoto "data:image/jpeg;base64,/9j/4AAQ..." .
""" .

# Note: foundation:hasFile is inherited from foundation:DigitalThing via foundation:InformationObject
# No need to redefine it here.

foundation:digitalSignature a owl:DatatypeProperty ;
    rdfs:label "digital signature" ;
    rdfs:comment "Digital signature or QR code data for document verification" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myCNH foundation:digitalSignature "QR_CODE_DATA_HERE" .
  :myPassport foundation:digitalSignature "CERTIFICATE_HASH" .
""" .

foundation:securityCode a owl:DatatypeProperty ;
    rdfs:label "security code" ;
    rdfs:comment "Security code or verification number for the document" ;
    rdfs:domain foundation:IdentificationDocument ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Example:
  :myCNH foundation:securityCode "62048143023" .
  :myRG foundation:securityCode "SPD08172338" .
""" .
