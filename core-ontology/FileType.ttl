@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# File and FileType
# =============================================================================
# File: Actual file instances in the system
# FileType: File types and formats with MIME types and extensions
#
# Version: 0.1.0
# License: MIT
# =============================================================================

# -----------------------------------------------------------------------------
# File - Actual file instance
# -----------------------------------------------------------------------------

foundation:File a owl:Class ;
    rdfs:subClassOf foundation:InformationObject ;
    rdfs:label "File"@en ;
    rdfs:label "Arquivo"@pt ;
    rdfs:comment "A digital file stored in the system or referenced externally" ;
    foundation:icon "insert_drive_file" ;
    rdfs:seeAlso """
Examples:
- CNH Digital PDF
- Passport photo JPEG
- Contract document PDF
- Profile picture PNG
- Invoice spreadsheet
""" .

# -----------------------------------------------------------------------------
# FileType - File format/type definition
# -----------------------------------------------------------------------------

foundation:FileType a owl:Class ;
    rdfs:subClassOf foundation:Concept ;
    rdfs:label "File Type"@en ;
    rdfs:label "Tipo de Arquivo"@pt ;
    rdfs:comment "A file format or type, defined by MIME type and file extension" ;
    foundation:icon "description" ;
    rdfs:seeAlso """
Examples:
- PDF (application/pdf)
- JPEG Image (image/jpeg)
- PNG Image (image/png)
- Word Document (application/vnd.openxmlformats-officedocument.wordprocessingml.document)
""" .

# -----------------------------------------------------------------------------
# File Properties
# -----------------------------------------------------------------------------

foundation:filePath a owl:DatatypeProperty ;
    rdfs:label "file path"@en ;
    rdfs:label "caminho do arquivo"@pt ;
    rdfs:comment "URI or file system path to the actual file" ;
    rdfs:domain foundation:File ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso """
Examples:
  :myCNHFile foundation:filePath "file:///documents/cnh-digital.pdf"^^xsd:anyURI .
  :myPhoto foundation:filePath "https://storage.example.com/photos/profile.jpg"^^xsd:anyURI .
  :myContract foundation:filePath "/home/user/contracts/contract-2024.pdf"^^xsd:anyURI .
""" .

foundation:fileName a owl:DatatypeProperty ;
    rdfs:label "file name"@en ;
    rdfs:label "nome do arquivo"@pt ;
    rdfs:comment "Original filename with extension" ;
    rdfs:domain foundation:File ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :myCNHFile foundation:fileName "cnh-digital.pdf" .
  :myPhoto foundation:fileName "profile-photo.jpg" .
  :myContract foundation:fileName "contract-signed-2024-01-15.pdf" .
""" .

foundation:fileSize a owl:DatatypeProperty ;
    rdfs:label "file size"@en ;
    rdfs:label "tamanho do arquivo"@pt ;
    rdfs:comment "Size of the file in bytes" ;
    rdfs:domain foundation:File ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:seeAlso """
Examples:
  :myPDF foundation:fileSize 1048576 .  # 1 MB in bytes
  :myPhoto foundation:fileSize 524288 .  # 512 KB in bytes
""" .

foundation:fileHash a owl:DatatypeProperty ;
    rdfs:label "file hash"@en ;
    rdfs:label "hash do arquivo"@pt ;
    rdfs:comment "Cryptographic hash of the file (SHA-256, MD5, etc.) for integrity verification" ;
    rdfs:domain foundation:File ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :myFile foundation:fileHash "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" .
  :myFile foundation:fileHash "md5:d41d8cd98f00b204e9800998ecf8427e" .
""" .

foundation:uploadDate a owl:DatatypeProperty ;
    rdfs:label "upload date"@en ;
    rdfs:label "data de upload"@pt ;
    rdfs:comment "Date and time when the file was uploaded or created in the system" ;
    rdfs:domain foundation:File ;
    rdfs:range xsd:dateTime ;
    rdfs:seeAlso """
Example:
  :myFile foundation:uploadDate "2024-01-15T14:30:00Z"^^xsd:dateTime .
""" .

foundation:hasFileType a owl:ObjectProperty ;
    rdfs:label "has file type"@en ;
    rdfs:label "tem tipo de arquivo"@pt ;
    rdfs:comment "Links a File to its FileType" ;
    rdfs:domain foundation:File ;
    rdfs:range foundation:FileType ;
    rdfs:seeAlso """
Examples:
  :myCNHFile foundation:hasFileType foundation:FileType_PDF .
  :myPhoto foundation:hasFileType foundation:FileType_JPEG .
  :myVideo foundation:hasFileType foundation:FileType_MP4 .
""" .

# -----------------------------------------------------------------------------
# FileType Properties
# -----------------------------------------------------------------------------

foundation:mimeType a owl:DatatypeProperty ;
    rdfs:label "MIME type"@en ;
    rdfs:label "tipo MIME"@pt ;
    rdfs:comment "Internet Media Type (MIME type) of the file" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :pdfType foundation:mimeType "application/pdf" .
  :jpegType foundation:mimeType "image/jpeg" .
  :pngType foundation:mimeType "image/png" .
""" .

foundation:fileExtension a owl:DatatypeProperty ;
    rdfs:label "file extension"@en ;
    rdfs:label "extensão de arquivo"@pt ;
    rdfs:comment "File extension (including the dot)" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :pdfType foundation:fileExtension ".pdf" .
  :jpegType foundation:fileExtension ".jpg" .
  :jpegType foundation:fileExtension ".jpeg" .
  :pngType foundation:fileExtension ".png" .
""" .

foundation:isTextBased a owl:DatatypeProperty ;
    rdfs:label "is text-based"@en ;
    rdfs:label "baseado em texto"@pt ;
    rdfs:comment "Whether the file format is text-based (true) or binary (false)" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """
Examples:
  :txtType foundation:isTextBased true .
  :pdfType foundation:isTextBased false .
  :xmlType foundation:isTextBased true .
""" .

foundation:supportsCompression a owl:DatatypeProperty ;
    rdfs:label "supports compression"@en ;
    rdfs:label "suporta compressão"@pt ;
    rdfs:comment "Whether the file format has built-in compression" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """
Examples:
  :pdfType foundation:supportsCompression true .
  :pngType foundation:supportsCompression true .
  :bmpType foundation:supportsCompression false .
""" .

foundation:category a owl:DatatypeProperty ;
    rdfs:label "category"@en ;
    rdfs:label "categoria"@pt ;
    rdfs:comment "General category of the file type (document, image, video, audio, etc.)" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :pdfType foundation:category "document" .
  :jpegType foundation:category "image" .
  :mp4Type foundation:category "video" .
  :mp3Type foundation:category "audio" .
""" .

# =============================================================================
# File Type Instances
# =============================================================================

# -----------------------------------------------------------------------------
# Document Types
# -----------------------------------------------------------------------------

foundation:FileType_PDF a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "PDF"@en ;
    rdfs:label "PDF"@pt ;
    rdfs:comment "Portable Document Format" ;
    foundation:mimeType "application/pdf" ;
    foundation:fileExtension ".pdf" ;
    foundation:isTextBased false ;
    foundation:supportsCompression true ;
    foundation:category "document" ;
    foundation:icon "picture_as_pdf" .

foundation:FileType_DOC a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "Word Document"@en ;
    rdfs:label "Documento Word"@pt ;
    rdfs:comment "Microsoft Word Document (legacy)" ;
    foundation:mimeType "application/msword" ;
    foundation:fileExtension ".doc" ;
    foundation:isTextBased false ;
    foundation:supportsCompression true ;
    foundation:category "document" ;
    foundation:icon "description" .

foundation:FileType_DOCX a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "Word Document (Modern)"@en ;
    rdfs:label "Documento Word (Moderno)"@pt ;
    rdfs:comment "Microsoft Word Open XML Document" ;
    foundation:mimeType "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ;
    foundation:fileExtension ".docx" ;
    foundation:isTextBased false ;
    foundation:supportsCompression true ;
    foundation:category "document" ;
    foundation:icon "description" .

foundation:FileType_TXT a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "Text File"@en ;
    rdfs:label "Arquivo de Texto"@pt ;
    rdfs:comment "Plain text file" ;
    foundation:mimeType "text/plain" ;
    foundation:fileExtension ".txt" ;
    foundation:isTextBased true ;
    foundation:supportsCompression false ;
    foundation:category "document" ;
    foundation:icon "text_snippet" .

