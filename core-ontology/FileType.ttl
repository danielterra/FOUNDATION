@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# FileType
# =============================================================================
# File types and formats with MIME types and extensions
#
# Version: 0.1.0
# License: MIT
# =============================================================================

foundation:FileType a owl:Class ;
    rdfs:subClassOf foundation:Concept ;
    rdfs:label "File Type"@en ;
    rdfs:label "Tipo de Arquivo"@pt ;
    rdfs:comment "A file format or type, defined by MIME type and file extension" ;
    foundation:icon "description" ;
    rdfs:seeAlso """
Examples:
- PDF (application/pdf)
- JPEG Image (image/jpeg)
- PNG Image (image/png)
- Word Document (application/vnd.openxmlformats-officedocument.wordprocessingml.document)
""" .

# -----------------------------------------------------------------------------
# FileType Properties
# -----------------------------------------------------------------------------

foundation:mimeType a owl:DatatypeProperty ;
    rdfs:label "MIME type"@en ;
    rdfs:label "tipo MIME"@pt ;
    rdfs:comment "Internet Media Type (MIME type) of the file" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :pdfType foundation:mimeType "application/pdf" .
  :jpegType foundation:mimeType "image/jpeg" .
  :pngType foundation:mimeType "image/png" .
""" .

foundation:fileExtension a owl:DatatypeProperty ;
    rdfs:label "file extension"@en ;
    rdfs:label "extensão de arquivo"@pt ;
    rdfs:comment "File extension (including the dot)" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :pdfType foundation:fileExtension ".pdf" .
  :jpegType foundation:fileExtension ".jpg" .
  :jpegType foundation:fileExtension ".jpeg" .
  :pngType foundation:fileExtension ".png" .
""" .

foundation:isTextBased a owl:DatatypeProperty ;
    rdfs:label "is text-based"@en ;
    rdfs:label "baseado em texto"@pt ;
    rdfs:comment "Whether the file format is text-based (true) or binary (false)" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """
Examples:
  :txtType foundation:isTextBased true .
  :pdfType foundation:isTextBased false .
  :xmlType foundation:isTextBased true .
""" .

foundation:supportsCompression a owl:DatatypeProperty ;
    rdfs:label "supports compression"@en ;
    rdfs:label "suporta compressão"@pt ;
    rdfs:comment "Whether the file format has built-in compression" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:boolean ;
    rdfs:seeAlso """
Examples:
  :pdfType foundation:supportsCompression true .
  :pngType foundation:supportsCompression true .
  :bmpType foundation:supportsCompression false .
""" .

foundation:category a owl:DatatypeProperty ;
    rdfs:label "category"@en ;
    rdfs:label "categoria"@pt ;
    rdfs:comment "General category of the file type (document, image, video, audio, etc.)" ;
    rdfs:domain foundation:FileType ;
    rdfs:range xsd:string ;
    rdfs:seeAlso """
Examples:
  :pdfType foundation:category "document" .
  :jpegType foundation:category "image" .
  :mp4Type foundation:category "video" .
  :mp3Type foundation:category "audio" .
""" .

# =============================================================================
# File Type Instances
# =============================================================================

# -----------------------------------------------------------------------------
# Document Types
# -----------------------------------------------------------------------------

foundation:FileType_PDF a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "PDF"@en ;
    rdfs:label "PDF"@pt ;
    rdfs:comment "Portable Document Format" ;
    foundation:mimeType "application/pdf" ;
    foundation:fileExtension ".pdf" ;
    foundation:isTextBased false ;
    foundation:supportsCompression true ;
    foundation:category "document" ;
    foundation:icon "picture_as_pdf" .

foundation:FileType_DOC a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "Word Document"@en ;
    rdfs:label "Documento Word"@pt ;
    rdfs:comment "Microsoft Word Document (legacy)" ;
    foundation:mimeType "application/msword" ;
    foundation:fileExtension ".doc" ;
    foundation:isTextBased false ;
    foundation:supportsCompression true ;
    foundation:category "document" ;
    foundation:icon "description" .

foundation:FileType_DOCX a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "Word Document (Modern)"@en ;
    rdfs:label "Documento Word (Moderno)"@pt ;
    rdfs:comment "Microsoft Word Open XML Document" ;
    foundation:mimeType "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ;
    foundation:fileExtension ".docx" ;
    foundation:isTextBased false ;
    foundation:supportsCompression true ;
    foundation:category "document" ;
    foundation:icon "description" .

foundation:FileType_TXT a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "Text File"@en ;
    rdfs:label "Arquivo de Texto"@pt ;
    rdfs:comment "Plain text file" ;
    foundation:mimeType "text/plain" ;
    foundation:fileExtension ".txt" ;
    foundation:isTextBased true ;
    foundation:supportsCompression false ;
    foundation:category "document" ;
    foundation:icon "text_snippet" .

