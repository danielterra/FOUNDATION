# -----------------------------------------------------------------------------
# Archive Types
# -----------------------------------------------------------------------------

foundation:FileType_ZIP a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "ZIP Archive"@en ;
    rdfs:label "Arquivo ZIP"@pt ;
    rdfs:comment "ZIP compressed archive" ;
    foundation:mimeType "application/zip" ;
    foundation:fileExtension ".zip" ;
    foundation:isTextBased false ;
    foundation:supportsCompression true ;
    foundation:category "archive" ;
    foundation:icon "folder_zip" .

foundation:FileType_RAR a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "RAR Archive"@en ;
    rdfs:label "Arquivo RAR"@pt ;
    rdfs:comment "RAR compressed archive" ;
    foundation:mimeType "application/vnd.rar" ;
    foundation:fileExtension ".rar" ;
    foundation:isTextBased false ;
    foundation:supportsCompression true ;
    foundation:category "archive" ;
    foundation:icon "folder_zip" .

foundation:FileType_7Z a foundation:FileType , owl:NamedIndividual ;
    rdfs:label "7-Zip Archive"@en ;
    rdfs:label "Arquivo 7-Zip"@pt ;
