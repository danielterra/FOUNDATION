    foundation:offeredBy foundation:ClaudeAIService ;
    foundation:modelVersion "3.0" ;
    foundation:contextWindow 200000 ;
    foundation:modelCapability "writing" ;
    foundation:modelCapability "complex_tasks" ;
    foundation:modelCapability "creativity" ;
    foundation:isDefaultModel false ;
    foundation:modelReleaseDate "2024-02-29"^^xsd:date .

