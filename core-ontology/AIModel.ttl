@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# =============================================================================
# AIModel
# =============================================================================
# A specific version/variant of an AI language model offered by a service
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

foundation:AIModel a owl:Class ;
    rdfs:subClassOf foundation:Concept ,
        [ a owl:Restriction ;
          owl:onProperty foundation:modelIdentifier ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty foundation:offeredBy ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "AI Model" ;
    rdfs:comment "A specific version or variant of an AI language model (e.g., Claude 3.5 Sonnet, GPT-4)" ;
    foundation:icon "psychology_alt" ;
    rdfs:seeAlso """
Examples:
- Claude 3.5 Sonnet (claude-3-5-sonnet-20240620)
- Claude 3 Opus (claude-3-opus-20240229)
- GPT-4 Turbo
- Gemini 1.5 Pro

Cardinality constraints:
- modelIdentifier: exactly 1 (required, unique ID for API calls)
- offeredBy: exactly 1 (required, which service provides this model)
""" .

# -----------------------------------------------------------------------------
# AIModel Properties
# -----------------------------------------------------------------------------

foundation:modelIdentifier a owl:DatatypeProperty ;
    rdfs:label "model identifier" ;
    rdfs:comment "The unique identifier used to reference this model in API calls (examples: 'claude-sonnet-4-5', 'claude-3-opus-20240229')" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:string .

foundation:offeredBy a owl:ObjectProperty ;
    rdfs:label "offered by" ;
    rdfs:comment "The AI service that provides this model" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range foundation:Service .

foundation:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version" ;
    rdfs:comment "Human-readable version of the model (e.g., '3.5', '4.0', '4.5')" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:string .

foundation:contextWindow a owl:DatatypeProperty ;
    rdfs:label "context window" ;
    rdfs:comment "Maximum number of tokens the model can process in one request (input tokens - examples: 200000, 128000)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:integer ;
    qudt:hasUnit unit:TokenCount .

foundation:maxInputTokens a owl:DatatypeProperty ;
    rdfs:label "max input tokens" ;
    rdfs:comment "Maximum number of tokens to SEND to the model per request (limits total input: system + tools + history + message). Default is 20% of context window. User can customize this value to control costs and context usage." ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:integer ;
    qudt:hasUnit unit:TokenCount .

foundation:modelCapability a owl:DatatypeProperty ;
    rdfs:label "model capability" ;
    rdfs:comment "Key capability or strength of this model (e.g., 'coding', 'writing', 'analysis', 'reasoning')" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:string .

foundation:isDefaultModel a owl:DatatypeProperty ;
    rdfs:label "is default model" ;
    rdfs:comment "Whether this model should be used as the default for its service (true or false)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:boolean .

foundation:isDeprecated a owl:DatatypeProperty ;
    rdfs:label "is deprecated" ;
    rdfs:comment "Whether this model is deprecated and should not be used for new projects (true or false)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:boolean .

foundation:modelReleaseDate a owl:DatatypeProperty ;
    rdfs:label "model release date" ;
    rdfs:comment "When this specific model version was released (format: YYYY-MM-DD)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:date .

# -----------------------------------------------------------------------------
# Pricing Properties
# -----------------------------------------------------------------------------
# All prices are per million tokens (MTok) in USD

foundation:inputPricePerMTok a owl:DatatypeProperty ;
    rdfs:label "input price per MTok" ;
    rdfs:comment "Base price in USD per million input tokens" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:decimal .

foundation:outputPricePerMTok a owl:DatatypeProperty ;
    rdfs:label "output price per MTok" ;
    rdfs:comment "Base price in USD per million output tokens" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:decimal .

foundation:cacheWrite5minPricePerMTok a owl:DatatypeProperty ;
    rdfs:label "cache write 5min price per MTok" ;
    rdfs:comment "Price in USD per million tokens for prompt caching write (5-minute TTL, typically 1.25x base input price)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:decimal .

foundation:cacheWrite1hPricePerMTok a owl:DatatypeProperty ;
    rdfs:label "cache write 1h price per MTok" ;
    rdfs:comment "Price in USD per million tokens for prompt caching write (1-hour TTL, typically 2x base input price)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:decimal .

foundation:cacheReadPricePerMTok a owl:DatatypeProperty ;
    rdfs:label "cache read price per MTok" ;
    rdfs:comment "Price in USD per million tokens for prompt caching read (typically 0.1x base input price)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:decimal .

foundation:batchInputPricePerMTok a owl:DatatypeProperty ;
    rdfs:label "batch input price per MTok" ;
    rdfs:comment "Price in USD per million input tokens for Batch API (typically 50% off base price)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:decimal .

foundation:batchOutputPricePerMTok a owl:DatatypeProperty ;
    rdfs:label "batch output price per MTok" ;
    rdfs:comment "Price in USD per million output tokens for Batch API (typically 50% off base price)" ;
    rdfs:domain foundation:AIModel ;
    rdfs:range xsd:decimal .

# =============================================================================
# Claude Model Instances
# =============================================================================

# Claude Sonnet 4.6 (LATEST - DEFAULT)
foundation:ClaudeSonnet46 a foundation:AIModel ;
    rdfs:label "Claude Sonnet 4.6" ;
    rdfs:comment "Latest Claude Sonnet model - best for coding, reasoning, and analysis" ;
    foundation:icon "psychology_alt" ;
    foundation:modelIdentifier "claude-sonnet-4-6" ;
    foundation:offeredBy foundation:ClaudeAIService ;
    foundation:modelVersion "4.6" ;
    foundation:contextWindow 200000 ;
    foundation:maxInputTokens 40000 ;
    foundation:modelCapability "coding" ;
    foundation:modelCapability "reasoning" ;
    foundation:modelCapability "analysis" ;
    foundation:isDefaultModel true ;
    foundation:isDeprecated false ;
    foundation:modelReleaseDate "2026-02-17"^^xsd:date ;
    foundation:inputPricePerMTok 3.0 ;
    foundation:outputPricePerMTok 15.0 ;
    foundation:cacheWrite5minPricePerMTok 3.75 ;
    foundation:cacheWrite1hPricePerMTok 6.0 ;
    foundation:cacheReadPricePerMTok 0.3 ;
    foundation:batchInputPricePerMTok 1.5 ;
    foundation:batchOutputPricePerMTok 7.5 .

