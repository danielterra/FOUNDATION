@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foundation: <http://foundation.local/ontology/> .

# =============================================================================
# SoftwareFeature
# =============================================================================
# A broad user-facing capability, decomposed into User Stories
#
# Version: 0.1.0
# License: GNU GPL
# =============================================================================

<http://foundation.local/ontology/SoftwareFeature>
    a owl:Ontology ;
    owl:imports <http://foundation.local/ontology/Goal> .

foundation:SoftwareFeature a owl:Class ;
    rdfs:subClassOf foundation:Goal ;
    rdfs:label "Software Feature" ;
    rdfs:comment "A broad user-facing capability, decomposed into User Stories that describe specific user needs" ;
    foundation:icon "star" ;
    rdfs:seeAlso """
Examples:
- User Authentication
- File Export
- Dark Mode
- Real-time Notifications
- Search

Relationship chain:
  SoftwareFeature
    ← UserStory (contributesTo) — specific user needs within this feature
      ← Plan (contributesTo) — design perspective per story: Backend, Frontend, UI/UX, Data, Ontology
        ← Task (contributesTo) — concrete work items, chained via dependsOn
""" .
