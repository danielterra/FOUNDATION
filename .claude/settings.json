{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet --release --manifest-path scripts/deps-check/Cargo.toml -- --hook",
            "shell": "bash",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git push 2>&1 || true",
            "if": "Bash(git commit *)",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
