{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FOUNDATION",
  "version": "../package.json",
  "identifier": "org.w3id.foundation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FOUNDATION",
        "width": 1280,
        "height": 800,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Documents/Foundation/attachments/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/foundation.mcpb": "foundation.mcpb",
      "resources/sqlite3.exe": "sqlite3.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI-powered ontology management system with long-term memory",
    "longDescription": "FOUNDATION is an AI assistant with persistent memory that organizes knowledge as semantic ontologies. It remembers everything you tell it across conversations and provides intelligent, context-aware interactions.",
    "copyright": "Copyright (c) 2026 Daniel Terra",
    "category": "Productivity",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
