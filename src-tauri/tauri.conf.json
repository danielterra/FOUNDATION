{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FOUNDATION",
  "version": "0.1.0",
  "identifier": "org.w3id.foundation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FOUNDATION",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI-powered ontology management system with long-term memory",
    "longDescription": "FOUNDATION is an AI assistant with persistent memory that organizes knowledge as semantic ontologies. It remembers everything you tell it across conversations and provides intelligent, context-aware interactions.",
    "copyright": "Copyright (c) 2026 Daniel Terra",
    "category": "Productivity",
    "licenseFile": "../LICENSE",
    "resources": [
      "../core-ontology"
    ],
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
