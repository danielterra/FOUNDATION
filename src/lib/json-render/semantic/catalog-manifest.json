    {
      "id": "Decision",
      "contractVersion": 1,
      "description": "Ajuda a escolher uma ou mais alternativas pelo domínio, volume, complexidade e fatores de comparação.",
      "propsSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "selectionMode": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ]
          },
          "complexity": {
            "type": "string",
            "enum": [
              "simple",
              "complex"
            ]
          },
          "groupName": {
            "type": "string"
          },
          "candidates": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "disabled": {
                  "type": "boolean"
                },
                "comparison": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "value",
                "title"
              ],
              "additionalProperties": false
            }
          },
          "selected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "comparisonFactors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consequence": {
            "type": "string"
          },
          "reversibility": {
            "type": "string",
            "enum": [
              "reversible",
              "hard_to_reverse",
              "irreversible"
            ]
          }
        },
        "required": [
          "title",
          "selectionMode",
          "complexity",
          "candidates"
        ],
        "additionalProperties": false
      },
      "slots": []
    },
    {
      "id": "ValueEntry",
      "contractVersion": 2,
      "description": "Apresenta ou coleta um valor respeitando tipo, unidade, validação, sensibilidade e editabilidade.",
      "propsSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "labelVisible": {
            "type": "boolean"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ]
          },
          "valueType": {
            "type": "string",
            "enum": [
              "text",
              "email",
              "number",
              "boolean",
              "date",
              "date_time",
              "currency",
              "percentage",
              "url",
              "code",
              "markdown",
              "html",
              "query_config",
              "recurrence_rule"
            ]
          },
          "language": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "validationMessage": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "sensitive": {
            "type": "boolean"
          },
          "editable": {
            "default": true,
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          }
