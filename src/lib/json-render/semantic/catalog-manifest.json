              "properties": {
                "source": {
                  "type": "string",
                  "const": "entity",
                  "description": "Lê da entidade declarada em foundation:rendersEntity."
                },
                "propertyIri": {
                  "type": "string",
                  "minLength": 1,
                  "description": "IRI da propriedade da ontologia lida no runtime."
                }
              },
              "required": [
                "source",
                "propertyIri"
